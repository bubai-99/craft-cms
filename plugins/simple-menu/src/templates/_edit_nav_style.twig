{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}

{% set title = isNew ? "Create a new navigation" : menu.name %}

{% block content %}
    <form method="post" accept-charset="UTF-8" data-saveshortcut>
        {{ csrfInput() }}
        {{ actionInput('simple-menu/menu/save') }}
        {{ redirectInput('simple-menu') }}
        
        {% if not isNew %}
            {{ hiddenInput('id', menu.id) }}
        {% endif %}

        <div class="grid first" data-max-cols="3">
            <div class="item" data-position="left" data-colspan="2">
                <div id="fields" class="pane">
                    {{ forms.textField({
                        label: "Name"|t,
                        instructions: "What this navigation will be called in the control panel."|t,
                        id: 'name',
                        name: 'name',
                        value: menu.name,
                        errors: menu.getErrors('name'),
                        autofocus: true,
                        required: true
                    }) }}

                    {{ forms.textField({
                        label: "Handle"|t,
                        instructions: "How you'll refer to this navigation in your templates."|t,
                        id: 'handle',
                        name: 'handle',
                        class: 'code',
                        autocorrect: false,
                        autocapitalize: false,
                        value: menu.handle,
                        errors: menu.getErrors('handle'),
                        required: true
                    }) }}

                    {{ forms.textField({
                        label: "Max Levels"|t,
                        instructions: "The maximum number of levels this navigation can have. Leave blank for no limit."|t,
                        id: 'maxLevels',
                        name: 'maxLevels',
                        type: 'number',
                        min: 1,
                        value: menu.maxLevels
                    }) }}

                    <div class="field navigation-builder-field">
                        <div class="heading">
                            <label>Navigation Structure</label>
                            <div class="instructions">
                                <p>Build your navigation by adding and arranging nodes.</p>
                            </div>
                        </div>
                        
                        <div class="navigation-builder">
                            <div class="navigation-toolbar">
                                <div class="btngroup">
                                    <button type="button" class="btn small add-node-btn" data-type="custom">
                                        <span class="icon add"></span>
                                        Custom URL
                                    </button>
                                    <button type="button" class="btn small add-node-btn" data-type="entry">
                                        <span class="icon add"></span>
                                        Entry
                                    </button>
                                    <button type="button" class="btn small add-node-btn" data-type="category">
                                        <span class="icon add"></span>
                                        Category
                                    </button>
                                    <button type="button" class="btn small add-node-btn" data-type="asset">
                                        <span class="icon add"></span>
                                        Asset
                                    </button>
                                </div>
                            </div>

                            <div class="navigation-nodes-container">
                                <div class="navigation-nodes">
                                    {% if menu.items|length %}
                                        {% for item in menu.items %}
                                            <div class="navigation-node" data-level="0">
                                                <div class="navigation-node-inner">
                                                    <div class="node-toggle"></div>
                                                    <div class="node-status">
                                                        <div class="status enabled"></div>
                                                    </div>
                                                    <div class="node-title">
                                                        <span class="title">{{ item.label|default('Untitled') }}</span>
                                                        <span class="url">{{ item.url|default('') }}</span>
                                                    </div>
                                                    <div class="node-actions">
                                                        <a class="btn small settings-btn" data-icon="settings" title="Settings"></a>
                                                        <a class="btn small delete-btn" data-icon="remove" title="Delete"></a>
                                                    </div>
                                                </div>
                                                
                                                <div class="navigation-node-settings" style="display: none;">
                                                    <div class="settings-content">
                                                        {{ forms.textField({
                                                            label: "Title"|t,
                                                            name: "items[#{loop.index0}][label]",
                                                            value: item.label,
                                                            placeholder: "Navigation title"
                                                        }) }}
                                                        
                                                        {{ forms.textField({
                                                            label: "URL"|t,
                                                            name: "items[#{loop.index0}][url]",
                                                            value: item.url,
                                                            placeholder: "https://example.com"
                                                        }) }}
                                                        
                                                        {{ forms.textField({
                                                            label: "CSS Classes"|t,
                                                            name: "items[#{loop.index0}][classes]",
                                                            value: item.classes|default(''),
                                                            placeholder: "my-class another-class"
                                                        }) }}
                                                        
                                                        {{ forms.checkboxField({
                                                            label: "Open in new window"|t,
                                                            name: "items[#{loop.index0}][newWindow]",
                                                            checked: item.newWindow|default(false)
                                                        }) }}
                                                        
                                                        {{ forms.checkboxField({
                                                            label: "Enabled"|t,
                                                            name: "items[#{loop.index0}][enabled]",
                                                            checked: item.enabled|default(true)
                                                        }) }}
                                                    </div>
                                                </div>
                                            </div>
                                        {% endfor %}
                                    {% else %}
                                        <div class="navigation-empty">
                                            <p>No navigation nodes yet. Use the buttons above to add your first node.</p>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="item" data-position="right" data-colspan="1">
                <div class="pane meta">
                    {% if not isNew %}
                        <div class="data">
                            <h5 class="heading">Template Usage</h5>
                            <div class="value">
                                <p>To render this navigation:</p>
                                <pre><code>{% verbatim %}{{ craft.simpleMenu.render('{{ menu.handle }}') }}{% endverbatim %}</code></pre>
                                
                                <p>Custom rendering:</p>
                                <pre><code>{% verbatim %}{% set nav = craft.simpleMenu.getMenuByHandle('{{ menu.handle }}') %}
<ul class="navigation">
  {% for node in nav.nodes %}
    <li><a href="{{ node.url }}">{{ node.title }}</a></li>
  {% endfor %}
</ul>{% endverbatim %}</code></pre>
                            </div>
                        </div>
                        
                        <hr>
                    {% endif %}
                    
                    <div class="data">
                        <h5 class="heading">Node Types</h5>
                        <div class="value">
                            <dl class="meta">
                                <dt>Custom URL</dt>
                                <dd>Link to any URL</dd>
                                <dt>Entry</dt>
                                <dd>Link to a Craft entry</dd>
                                <dt>Category</dt>
                                <dd>Link to a category</dd>
                                <dt>Asset</dt>
                                <dd>Link to an asset</dd>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="buttons">
            <button type="submit" class="btn submit">
                {{ (isNew ? "Create Navigation" : "Save Navigation")|t }}
            </button>
        </div>
    </form>
{% endblock %}

{% js %}
$(document).ready(function() {
    // Handle generator
    new Craft.HandleGenerator('#name', '#handle');
    
    var nodeIndex = {{ menu.items|length|default(0) }};
    
    // Add node functionality
    $('.add-node-btn').on('click', function(e) {
        e.preventDefault();
        var type = $(this).data('type');
        addNavigationNode(type);
    });
    
    // Toggle settings
    $(document).on('click', '.settings-btn', function(e) {
        e.preventDefault();
        var $node = $(this).closest('.navigation-node');
        $node.find('.navigation-node-settings').slideToggle();
        $(this).toggleClass('active');
    });
    
    // Delete node
    $(document).on('click', '.delete-btn', function(e) {
        e.preventDefault();
        if (confirm('Are you sure you want to delete this navigation node?')) {
            $(this).closest('.navigation-node').remove();
            checkEmptyState();
        }
    });
    
    function addNavigationNode(type) {
        $('.navigation-empty').remove();
        
        var nodeHtml = '<div class="navigation-node" data-level="0">' +
            '<div class="navigation-node-inner">' +
                '<div class="node-toggle"></div>' +
                '<div class="node-status">' +
                    '<div class="status enabled"></div>' +
                '</div>' +
                '<div class="node-title">' +
                    '<span class="title">New ' + type.charAt(0).toUpperCase() + type.slice(1) + ' Node</span>' +
                    '<span class="url"></span>' +
                '</div>' +
                '<div class="node-actions">' +
                    '<a class="btn small settings-btn" data-icon="settings" title="Settings"></a>' +
                    '<a class="btn small delete-btn" data-icon="remove" title="Delete"></a>' +
                '</div>' +
            '</div>' +
            '<div class="navigation-node-settings" style="display: block;">' +
                '<div class="settings-content">' +
                    getNodeSettingsForm(type, nodeIndex) +
                '</div>' +
            '</div>' +
        '</div>';
        
        $('.navigation-nodes').append(nodeHtml);
        nodeIndex++;
    }
    
    function getNodeSettingsForm(type, index) {
        var form = '';
        
        if (type === 'custom') {
            form += '<div class="field">';
            form += '<div class="heading"><label>Title</label></div>';
            form += '<div class="input"><input type="text" name="items[' + index + '][label]" class="text fullwidth" placeholder="Navigation title"></div>';
            form += '</div>';
            
            form += '<div class="field">';
            form += '<div class="heading"><label>URL</label></div>';
            form += '<div class="input"><input type="text" name="items[' + index + '][url]" class="text fullwidth" placeholder="https://example.com"></div>';
            form += '</div>';
        }
        
        // Common fields
        form += '<div class="field">';
        form += '<div class="heading"><label>CSS Classes</label></div>';
        form += '<div class="input"><input type="text" name="items[' + index + '][classes]" class="text fullwidth" placeholder="my-class another-class"></div>';
        form += '</div>';
        
        form += '<div class="field">';
        form += '<div class="input"><label><input type="checkbox" name="items[' + index + '][newWindow]" value="1"> Open in new window</label></div>';
        form += '</div>';
        
        form += '<div class="field">';
        form += '<div class="input"><label><input type="checkbox" name="items[' + index + '][enabled]" value="1" checked> Enabled</label></div>';
        form += '</div>';
        
        return form;
    }
    
    function checkEmptyState() {
        if ($('.navigation-nodes .navigation-node').length === 0) {
            $('.navigation-nodes').append('<div class="navigation-empty"><p>No navigation nodes yet. Use the buttons above to add your first node.</p></div>');
        }
    }
});
{% endjs %}

{% css %}
/* Navigation Builder Styles */
.navigation-builder {
    border: 1px solid #e3e5e8;
    border-radius: 5px;
    background: #fff;
}

.navigation-toolbar {
    background: #fafafa;
    border-bottom: 1px solid #e3e5e8;
    padding: 14px 20px;
}

.navigation-nodes-container {
    min-height: 200px;
    max-height: 600px;
    overflow-y: auto;
}

.navigation-empty {
    padding: 40px 20px;
    text-align: center;
    color: #8f98a3;
}

/* Navigation Node Styles */
.navigation-node {
    border-bottom: 1px solid #f1f5f8;
}

.navigation-node-inner {
    display: flex;
    align-items: center;
    padding: 12px 20px;
    min-height: 44px;
    background: #fff;
    cursor: pointer;
}

.navigation-node-inner:hover {
    background: #fafafa;
}

.node-toggle {
    width: 16px;
    height: 16px;
    margin-right: 8px;
    cursor: pointer;
}

.node-status {
    margin-right: 8px;
}

.node-status .status {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #00d084;
    display: block;
}

.node-status .status.disabled {
    background: #da5a47;
}

.node-title {
    flex: 1;
    margin-right: 8px;
}

.node-title .title {
    font-weight: 600;
    color: #3c4858;
    display: block;
}

.node-title .url {
    font-size: 12px;
    color: #8f98a3;
    display: block;
    margin-top: 2px;
}

.node-actions {
    display: flex;
    gap: 4px;
}

.node-actions .btn {
    opacity: 0.7;
    transition: opacity 0.2s;
}

.node-actions .btn:hover,
.node-actions .btn.active {
    opacity: 1;
}

/* Node Settings */
.navigation-node-settings {
    background: #fafafa;
    border-top: 1px solid #f1f5f8;
}

.settings-content {
    padding: 20px;
}

.settings-content .field {
    margin-bottom: 16px;
}

.settings-content .field:last-child {
    margin-bottom: 0;
}

/* Button Group */
.btngroup .btn {
    margin-right: 4px;
}

.btngroup .btn:last-child {
    margin-right: 0;
}

/* Status indicators */
.status.enabled {
    background-color: #00d084;
}

.status.disabled {
    background-color: #da5a47;
}
{% endcss %}