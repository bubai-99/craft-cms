{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}

{% set title = isNew ? "Create a new navigation"|t('simple-menu') : nav.name %}

{% block content %}
    <form method="post" accept-charset="UTF-8" data-saveshortcut>
        {{ csrfInput() }}
        {{ actionInput('simple-menu/nav/save') }}
        {{ redirectInput('simple-menu/navs') }}
        
        {% if not isNew %}
            {{ hiddenInput('id', nav.id) }}
        {% endif %}

        <div class="grid first" data-max-cols="3">
            <div class="item" data-position="left" data-colspan="2">
                <div id="fields" class="pane">
                    {{ forms.textField({
                        label: "Name"|t('simple-menu'),
                        instructions: "What this navigation will be called in the control panel."|t('simple-menu'),
                        id: 'name',
                        name: 'name',
                        value: nav.name,
                        errors: nav.getErrors('name'),
                        autofocus: true,
                        required: true
                    }) }}

                    {{ forms.textField({
                        label: "Handle"|t('simple-menu'),
                        instructions: "How you'll refer to this navigation in your templates."|t('simple-menu'),
                        id: 'handle',
                        name: 'handle',
                        class: 'code',
                        autocorrect: false,
                        autocapitalize: false,
                        value: nav.handle,
                        errors: nav.getErrors('handle'),
                        required: true
                    }) }}

                    {{ forms.textareaField({
                        label: "Instructions"|t('simple-menu'),
                        instructions: "Helper text to guide content authors."|t('simple-menu'),
                        id: 'instructions',
                        name: 'instructions',
                        value: nav.instructions,
                        rows: 2
                    }) }}

                    {{ forms.textField({
                        label: "Max Levels"|t('simple-menu'),
                        instructions: "The maximum number of levels this navigation can have. Leave blank for no limit."|t('simple-menu'),
                        id: 'maxLevels',
                        name: 'maxLevels',
                        type: 'number',
                        min: 1,
                        value: nav.maxLevels
                    }) }}

                    {% if not isNew %}
                        <div class="field navigation-builder-field">
                            <div class="heading">
                                <label>{{ "Navigation Structure"|t('simple-menu') }}</label>
                                <div class="instructions">
                                    <p>{{ "Build your navigation by adding and arranging nodes."|t('simple-menu') }}</p>
                                </div>
                            </div>
                            
                            <div class="navigation-builder" id="navigation-builder">
                                <div class="navigation-toolbar">
                                    <div class="btngroup">
                                        <button type="button" class="btn small add-node-btn" data-type="custom">
                                            <span class="icon add"></span>
                                            {{ "Custom URL"|t('simple-menu') }}
                                        </button>
                                        <button type="button" class="btn small add-node-btn" data-type="entry">
                                            <span class="icon add"></span>
                                            {{ "Entry"|t('simple-menu') }}
                                        </button>
                                        <button type="button" class="btn small add-node-btn" data-type="category">
                                            <span class="icon add"></span>
                                            {{ "Category"|t('simple-menu') }}
                                        </button>
                                        <button type="button" class="btn small add-node-btn" data-type="asset">
                                            <span class="icon add"></span>
                                            {{ "Asset"|t('simple-menu') }}
                                        </button>
                                    </div>
                                </div>

                                <div class="navigation-nodes-container">
                                    <div class="navigation-nodes" id="navigation-nodes">
                                        {% set nodes = nav.getNodes() %}
                                        {% if nodes|length %}
                                            {% for node in nodes %}
                                                {{ include('simple-menu/navs/_node.twig', { 
                                                    node: node,
                                                    index: loop.index0
                                                }) }}
                                            {% endfor %}
                                        {% else %}
                                            <div class="navigation-empty">
                                                <p>{{ "No navigation nodes yet. Use the buttons above to add your first node."|t('simple-menu') }}</p>
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <div class="field">
                            <div class="heading">
                                <label>{{ "Navigation Structure"|t('simple-menu') }}</label>
                            </div>
                            <div class="input">
                                <p class="light">{{ "Save this navigation to start building your structure."|t('simple-menu') }}</p>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>

            <div class="item" data-position="right" data-colspan="1">
                <div class="pane meta">
                    {% if not isNew %}
                        <div class="data">
                            <h5 class="heading">{{ "Template Usage"|t('simple-menu') }}</h5>
                            <div class="value">
                                <p>{{ "To render this navigation:"|t('simple-menu') }}</p>
                                <pre><code>{% verbatim %}{{ craft.navigation.render('{{ nav.handle }}') }}{% endverbatim %}</code></pre>
                                
                                <p>{{ "Advanced rendering:"|t('simple-menu') }}</p>
                                <pre><code>{% verbatim %}{% nav node in craft.navigation.getNavByHandle('{{ nav.handle }}').getNodes() %}
  <li>
    <a href="{{ node.url }}">{{ node.title }}</a>
    {% ifchildren %}
      <ul>
        {% children %}
      </ul>
    {% endifchildren %}
  </li>
{% endnav %}{% endverbatim %}</code></pre>
                            </div>
                        </div>
                        
                        <hr>
                    {% endif %}
                    
                    <div class="data">
                        <h5 class="heading">{{ "Node Types"|t('simple-menu') }}</h5>
                        <div class="value">
                            <dl class="meta">
                                <dt>{{ "Custom URL"|t('simple-menu') }}</dt>
                                <dd>{{ "Link to any URL"|t('simple-menu') }}</dd>
                                <dt>{{ "Entry"|t('simple-menu') }}</dt>
                                <dd>{{ "Link to a Craft entry"|t('simple-menu') }}</dd>
                                <dt>{{ "Category"|t('simple-menu') }}</dt>
                                <dd>{{ "Link to a category"|t('simple-menu') }}</dd>
                                <dt>{{ "Asset"|t('simple-menu') }}</dt>
                                <dd>{{ "Link to an asset"|t('simple-menu') }}</dd>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="buttons">
            <button type="submit" class="btn submit">
                {{ (isNew ? "Create Navigation" : "Save Navigation")|t('simple-menu') }}
            </button>
        </div>
    </form>
{% endblock %}

{% js %}
$(document).ready(function() {
    // Handle generator
    new Craft.HandleGenerator('#name', '#handle');
    
    {% if not isNew %}
    var nodeIndex = {{ nav.getNodes()|length }};
    
    // Add node functionality
    $('.add-node-btn').on('click', function(e) {
        e.preventDefault();
        var type = $(this).data('type');
        addNavigationNode(type);
    });
    
    // Toggle settings
    $(document).on('click', '.settings-btn', function(e) {
        e.preventDefault();
        var $node = $(this).closest('.navigation-node');
        $node.find('.navigation-node-settings').slideToggle();
        $(this).toggleClass('active');
    });
    
    // Delete node
    $(document).on('click', '.delete-btn', function(e) {
        e.preventDefault();
        if (confirm('Are you sure you want to delete this navigation node?')) {
            $(this).closest('.navigation-node').remove();
            checkEmptyState();
        }
    });
    
    function addNavigationNode(type) {
        $('.navigation-empty').remove();
        
        var nodeHtml = getNodeHtml(type, nodeIndex);
        var $node = $(nodeHtml);
        $('#navigation-nodes').append($node);
        
        // Initialize element selectors for non-custom types
        if (type !== 'custom') {
            setTimeout(function() {
                var $elementSelect = $node.find('.elementselect');
                var elementType = type === 'entry' ? 'craft\\elements\\Entry' : 
                                 type === 'category' ? 'craft\\elements\\Category' :
                                 type === 'asset' ? 'craft\\elements\\Asset' : '';
                
                if (elementType && $elementSelect.length) {
                    var elementSelect = new Craft.ElementSelectInput({
                        id: 'element-select-' + nodeIndex,
                        name: 'nodes[' + nodeIndex + '][elementId]',
                        elementType: elementType,
                        limit: 1,
                        elements: [],
                        addButtonLabel: 'Add ' + type
                    });
                    
                    $elementSelect.replaceWith(elementSelect.$container);
                }
            }, 100);
        }
        
        nodeIndex++;
    }
    
    function getNodeHtml(type, index) {
        return '<div class="navigation-node" data-level="0">' +
            '<div class="navigation-node-inner">' +
                '<div class="node-status">' +
                    '<div class="status enabled"></div>' +
                '</div>' +
                '<div class="node-title">' +
                    '<span class="title">New ' + type.charAt(0).toUpperCase() + type.slice(1) + ' Node</span>' +
                    '<span class="url"></span>' +
                '</div>' +
                '<div class="node-actions">' +
                    '<a class="btn small settings-btn" data-icon="settings" title="Settings"></a>' +
                    '<a class="btn small delete-btn" data-icon="remove" title="Delete"></a>' +
                '</div>' +
            '</div>' +
            '<div class="navigation-node-settings" style="display: block;">' +
                '<div class="settings-content">' +
                    getNodeSettingsForm(type, index) +
                '</div>' +
            '</div>' +
        '</div>';
    }
    
    function getNodeSettingsForm(type, index) {
        var form = '<input type="hidden" name="nodes[' + index + '][type]" value="' + type + '">';
        
        // Title field for all types
        form += '<div class="field">';
        form += '<div class="heading"><label>Title</label></div>';
        form += '<div class="input"><input type="text" name="nodes[' + index + '][title]" class="text fullwidth" placeholder="Navigation title"></div>';
        form += '</div>';
        
        if (type === 'custom') {
            form += '<div class="field">';
            form += '<div class="heading"><label>URL</label></div>';
            form += '<div class="input"><input type="text" name="nodes[' + index + '][customUrl]" class="text fullwidth" placeholder="https://example.com"></div>';
            form += '</div>';
        } else if (type === 'entry') {
            form += '<div class="field">';
            form += '<div class="heading"><label>Entry</label></div>';
            form += '<div class="input">';
            form += '<div class="elementselect" data-type="entry" data-index="' + index + '"></div>';
            form += '</div>';
            form += '</div>';
        } else if (type === 'category') {
            form += '<div class="field">';
            form += '<div class="heading"><label>Category</label></div>';
            form += '<div class="input">';
            form += '<div class="elementselect" data-type="category" data-index="' + index + '"></div>';
            form += '</div>';
            form += '</div>';
        } else if (type === 'asset') {
            form += '<div class="field">';
            form += '<div class="heading"><label>Asset</label></div>';
            form += '<div class="input">';
            form += '<div class="elementselect" data-type="asset" data-index="' + index + '"></div>';
            form += '</div>';
            form += '</div>';
        }
        
        // Common fields
        form += '<div class="field">';
        form += '<div class="heading"><label>CSS Classes</label></div>';
        form += '<div class="input"><input type="text" name="nodes[' + index + '][classes]" class="text fullwidth" placeholder="my-class another-class"></div>';
        form += '</div>';
        
        form += '<div class="field">';
        form += '<div class="input"><label><input type="checkbox" name="nodes[' + index + '][newWindow]" value="1"> Open in new window</label></div>';
        form += '</div>';
        
        form += '<div class="field">';
        form += '<div class="input"><label><input type="checkbox" name="nodes[' + index + '][enabled]" value="1" checked> Enabled</label></div>';
        form += '</div>';
        
        return form;
    }
    
    function checkEmptyState() {
        if ($('#navigation-nodes .navigation-node').length === 0) {
            $('#navigation-nodes').append('<div class="navigation-empty"><p>No navigation nodes yet. Use the buttons above to add your first node.</p></div>');
        }
    }
    {% endif %}
});
{% endjs %}

{% css %}
/* Verbb Navigation Builder Styles */
.navigation-builder {
    border: 1px solid #e3e5e8;
    border-radius: 5px;
    background: #fff;
}

.navigation-toolbar {
    background: #fafafa;
    border-bottom: 1px solid #e3e5e8;
    padding: 14px 20px;
}

.navigation-nodes-container {
    min-height: 200px;
    max-height: 600px;
    overflow-y: auto;
}

.navigation-empty {
    padding: 40px 20px;
    text-align: center;
    color: #8f98a3;
}

.navigation-node {
    border-bottom: 1px solid #f1f5f8;
}

.navigation-node-inner {
    display: flex;
    align-items: center;
    padding: 12px 20px;
    min-height: 44px;
    background: #fff;
    cursor: pointer;
}

.navigation-node-inner:hover {
    background: #fafafa;
}

.node-status {
    margin-right: 12px;
}

.node-status .status {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #00d084;
    display: block;
}

.node-status .status.disabled {
    background: #da5a47;
}

.node-title {
    flex: 1;
    margin-right: 8px;
}

.node-title .title {
    font-weight: 600;
    color: #3c4858;
    display: block;
}

.node-title .url {
    font-size: 12px;
    color: #8f98a3;
    display: block;
    margin-top: 2px;
}

.node-actions {
    display: flex;
    gap: 4px;
}

.node-actions .btn {
    opacity: 0.7;
    transition: opacity 0.2s;
}

.node-actions .btn:hover,
.node-actions .btn.active {
    opacity: 1;
}

.navigation-node-settings {
    background: #fafafa;
    border-top: 1px solid #f1f5f8;
}

.settings-content {
    padding: 20px;
}

.settings-content .field {
    margin-bottom: 16px;
}

.settings-content .field:last-child {
    margin-bottom: 0;
}
{% endcss %}