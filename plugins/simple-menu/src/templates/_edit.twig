{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}

{% set title = isNew ? "Create a New Menu" : menu.name %}

{% block content %}
    <form method="post" accept-charset="UTF-8" data-saveshortcut>
        {{ csrfInput() }}
        {{ actionInput('simple-menu/menu/save') }}
        {{ redirectInput('simple-menu') }}
        
        {% if not isNew %}
            {{ hiddenInput('id', menu.id) }}
        {% endif %}

        <div class="grid first" data-max-cols="3">
            <div class="item" data-position="left" data-colspan="2">
                <div id="fields" class="pane">
                    {{ forms.textField({
                        label: "Name"|t,
                        instructions: "What this menu will be called in the control panel."|t,
                        id: 'name',
                        name: 'name',
                        value: menu.name,
                        errors: menu.getErrors('name'),
                        autofocus: true,
                        required: true
                    }) }}

                    {{ forms.textField({
                        label: "Handle"|t,
                        instructions: "How you'll refer to this menu in your templates."|t,
                        id: 'handle',
                        name: 'handle',
                        class: 'code',
                        autocorrect: false,
                        autocapitalize: false,
                        value: menu.handle,
                        errors: menu.getErrors('handle'),
                        required: true
                    }) }}

                    <div class="field">
                        <div class="heading">
                            <label for="menu-items">Menu Items</label>
                            <div class="instructions">
                                <p>Build your menu structure below. Add items one by one.</p>
                            </div>
                        </div>
                        <div class="input">
                            <div id="menu-items">
                                <div class="menu-item-list">
                                    {% if menu.items|length %}
                                        {% for item in menu.items %}
                                            <div class="menu-item">
                                                <div class="menu-item-fields">
                                                    <input type="text" name="items[{{ loop.index0 }}][label]" 
                                                           value="{{ item.label|default('') }}" placeholder="Label" class="text fullwidth">
                                                    <input type="text" name="items[{{ loop.index0 }}][url]" 
                                                           value="{{ item.url|default('') }}" placeholder="URL" class="text fullwidth">
                                                    <a class="delete icon" title="Delete this item"></a>
                                                </div>
                                            </div>
                                        {% endfor %}
                                    {% endif %}
                                </div>
                                <button type="button" class="btn add icon" id="add-menu-item">Add Menu Item</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="item" data-position="right" data-colspan="1">
                <div class="pane meta">
                    <div class="data">
                        <h5 class="heading">Usage</h5>
                        {% if not isNew %}
                            <div class="value">
                                <p>To render this menu in your templates:</p>
                                <pre><code>{% verbatim %}{% set menu = craft.simpleMenu.getMenuByHandle('{{ menu.handle }}') %}
{% if menu %}
  <ul>
    {% for item in menu.items %}
      <li><a href="{{ item.url }}">{{ item.label }}</a></li>
    {% endfor %}
  </ul>
{% endif %}{% endverbatim %}</code></pre>
                            </div>
                        {% else %}
                            <div class="value">
                                <p>Save this menu to see usage instructions.</p>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        <div class="buttons">
            <button type="submit" class="btn submit">{{ (isNew ? "Create Menu" : "Save Menu")|t }}</button>
        </div>
    </form>

{% endblock %}

{% js %}
$(document).ready(function() {
    // Handle generator
    new Craft.HandleGenerator('#name', '#handle');

    // Menu item management
    var itemIndex = {% if menu.items %}{{ menu.items|length }}{% else %}0{% endif %};

    $('#add-menu-item').on('click', function(e) {
        e.preventDefault();
        console.log('Add menu item clicked'); // Debug log
        
        var html = '<div class="menu-item">' +
            '<div class="menu-item-fields">' +
                '<input type="text" name="items[' + itemIndex + '][label]" placeholder="Label" class="text fullwidth">' +
                '<input type="text" name="items[' + itemIndex + '][url]" placeholder="URL" class="text fullwidth">' +
                '<a class="delete icon" title="Delete this item"></a>' +
            '</div>' +
        '</div>';
        
        $('.menu-item-list').append(html);
        itemIndex++;
    });

    $(document).on('click', '.menu-item .delete', function(e) {
        e.preventDefault();
        console.log('Delete clicked'); // Debug log
        $(this).closest('.menu-item').remove();
    });
});
{% endjs %}

{% css %}
.menu-item {
    margin-bottom: 10px;
    padding: 10px;
    background: #f9f9f9;
    border-radius: 3px;
}

.menu-item-fields {
    display: flex;
    gap: 10px;
    align-items: center;
}

.menu-item-fields input {
    margin-bottom: 0 !important;
}

.menu-item-fields .delete {
    flex-shrink: 0;
}

#menu-items .btn.add {
    margin-top: 10px;
}
{% endcss %}