{# Default navigation rendering template #}
{% if nodes|length %}
<ul class="navigation"{% if options.class %} class="{{ options.class }}"{% endif %}{% if options.id %} id="{{ options.id }}"{% endif %}>
    {% for node in nodes %}
        {% if node.enabled %}
            <li class="nav-item{% if node.classes %} {{ node.classes }}{% endif %}">
                <a href="{{ node.getUrl() }}"{% if node.newWindow %} target="_blank"{% endif %} class="nav-link">
                    {{ node.getTitle() }}
                </a>
                {% if node.children|length %}
                    <ul class="nav-submenu">
                        {% for child in node.children %}
                            {% if child.enabled %}
                                <li class="nav-subitem{% if child.classes %} {{ child.classes }}{% endif %}">
                                    <a href="{{ child.getUrl() }}"{% if child.newWindow %} target="_blank"{% endif %} class="nav-sublink">
                                        {{ child.getTitle() }}
                                    </a>
                                </li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                {% endif %}
            </li>
        {% endif %}
    {% endfor %}
</ul>
{% endif %}