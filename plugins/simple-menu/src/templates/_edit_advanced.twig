{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}

{% set title = isNew ? "Create a New Navigation" : menu.name %}

{% block content %}
    <form method="post" accept-charset="UTF-8" data-saveshortcut>
        {{ csrfInput() }}
        {{ actionInput('simple-menu/menu/save') }}
        {{ redirectInput('simple-menu') }}
        
        {% if not isNew %}
            {{ hiddenInput('id', menu.id) }}
        {% endif %}

        <div class="grid first" data-max-cols="3">
            <div class="item" data-position="left" data-colspan="2">
                <div id="fields" class="pane">
                    {{ forms.textField({
                        label: "Name"|t,
                        instructions: "What this navigation will be called in the control panel."|t,
                        id: 'name',
                        name: 'name',
                        value: menu.name,
                        errors: menu.getErrors('name'),
                        autofocus: true,
                        required: true
                    }) }}

                    {{ forms.textField({
                        label: "Handle"|t,
                        instructions: "How you'll refer to this navigation in your templates."|t,
                        id: 'handle',
                        name: 'handle',
                        class: 'code',
                        autocorrect: false,
                        autocapitalize: false,
                        value: menu.handle,
                        errors: menu.getErrors('handle'),
                        required: true
                    }) }}

                    {{ forms.textField({
                        label: "Max Levels"|t,
                        instructions: "The maximum number of levels this navigation can have. Leave blank for no limit."|t,
                        id: 'maxLevels',
                        name: 'maxLevels',
                        type: 'number',
                        min: 1,
                        value: menu.maxLevels
                    }) }}

                    <div class="field">
                        <div class="heading">
                            <label>Navigation Structure</label>
                            <div class="instructions">
                                <p>Build your navigation by adding nodes. Each node can link to Craft elements or custom URLs.</p>
                            </div>
                        </div>
                        <div class="input">
                            <div id="navigation-builder" class="navigation-builder">
                                <div class="navigation-nodes">
                                    {% if menu.items|length %}
                                        {% for item in menu.items %}
                                            <div class="navigation-node" data-level="1">
                                                <div class="node-header">
                                                    <div class="node-title">
                                                        {{ item.label|default('Untitled') }}
                                                        <span class="node-url">{{ item.url|default('') }}</span>
                                                    </div>
                                                    <div class="node-actions">
                                                        <a class="node-settings btn small" title="Edit Node">Settings</a>
                                                        <a class="node-delete btn small" title="Delete Node">Delete</a>
                                                    </div>
                                                </div>
                                                <div class="node-form" style="display: none;">
                                                    {{ include('simple-menu/_node_form', {
                                                        node: {
                                                            type: 'custom',
                                                            title: item.label,
                                                            customUrl: item.url,
                                                            enabled: true,
                                                            newWindow: false,
                                                            classes: ''
                                                        },
                                                        index: loop.index0
                                                    }) }}
                                                </div>
                                            </div>
                                        {% endfor %}
                                    {% endif %}
                                </div>
                                
                                <div class="navigation-actions">
                                    <div class="btn-group">
                                        <button type="button" class="btn submit add-node" data-type="custom">Add Custom URL</button>
                                        <button type="button" class="btn add-node" data-type="entry">Add Entry</button>
                                        <button type="button" class="btn add-node" data-type="category">Add Category</button>
                                        <button type="button" class="btn add-node" data-type="asset">Add Asset</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="item" data-position="right" data-colspan="1">
                <div class="pane meta">
                    <div class="data">
                        <h5 class="heading">Usage</h5>
                        {% if not isNew %}
                            <div class="value">
                                <p>To render this navigation in your templates:</p>
                                <pre><code>{% verbatim %}{% set nav = craft.simpleMenu.getMenuByHandle('{{ menu.handle }}') %}
{% if nav %}
  {{ craft.simpleMenu.render(nav) }}
{% endif %}

{# Or custom rendering #}
{% if nav %}
  <ul class="navigation">
    {% nav node in nav.getNodes() %}
      <li>
        <a href="{{ node.url }}"{% if node.newWindow %} target="_blank"{% endif %}{% if node.classes %} class="{{ node.classes }}"{% endif %}>
          {{ node.title }}
        </a>
        {% ifchildren %}
          <ul>
            {% children %}
          </ul>
        {% endifchildren %}
      </li>
    {% endnav %}
  </ul>
{% endif %}{% endverbatim %}</code></pre>
                            </div>
                        {% else %}
                            <div class="value">
                                <p>Save this navigation to see usage instructions.</p>
                            </div>
                        {% endif %}
                    </div>
                    
                    <div class="data">
                        <h5 class="heading">Node Types</h5>
                        <div class="value">
                            <ul>
                                <li><strong>Custom URL:</strong> Link to any URL</li>
                                <li><strong>Entry:</strong> Link to a Craft entry</li>
                                <li><strong>Category:</strong> Link to a category</li>
                                <li><strong>Asset:</strong> Link to an asset</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="buttons">
            <button type="submit" class="btn submit">{{ (isNew ? "Create Navigation" : "Save Navigation")|t }}</button>
        </div>
    </form>
{% endblock %}

{% js %}
$(document).ready(function() {
    // Handle generator
    new Craft.HandleGenerator('#name', '#handle');
    
    var nodeIndex = {{ menu.items|length|default(0) }};
    
    // Add node functionality
    $('.add-node').on('click', function(e) {
        e.preventDefault();
        var type = $(this).data('type');
        addNavigationNode(type);
    });
    
    // Toggle node settings
    $(document).on('click', '.node-settings', function(e) {
        e.preventDefault();
        $(this).closest('.navigation-node').find('.node-form').toggle();
    });
    
    // Delete node
    $(document).on('click', '.node-delete', function(e) {
        e.preventDefault();
        if (confirm('Are you sure you want to delete this node?')) {
            $(this).closest('.navigation-node').remove();
        }
    });
    
    function addNavigationNode(type) {
        var nodeHtml = '<div class="navigation-node" data-level="1">' +
            '<div class="node-header">' +
                '<div class="node-title">New ' + type.charAt(0).toUpperCase() + type.slice(1) + ' Node</div>' +
                '<div class="node-actions">' +
                    '<a class="node-settings btn small">Settings</a>' +
                    '<a class="node-delete btn small">Delete</a>' +
                '</div>' +
            '</div>' +
            '<div class="node-form" style="display: block;">' +
                getNodeForm(type, nodeIndex) +
            '</div>' +
        '</div>';
        
        $('.navigation-nodes').append(nodeHtml);
        nodeIndex++;
    }
    
    function getNodeForm(type, index) {
        // This would be replaced with actual Twig rendering
        var form = '<div class="node-form-fields">';
        
        form += '<input type="hidden" name="nodes[' + index + '][type]" value="' + type + '">';
        
        if (type === 'custom') {
            form += '<div class="field">';
            form += '<label>Title</label>';
            form += '<input type="text" name="nodes[' + index + '][title]" class="text fullwidth" placeholder="Navigation title">';
            form += '</div>';
            
            form += '<div class="field">';
            form += '<label>URL</label>';
            form += '<input type="text" name="nodes[' + index + '][customUrl]" class="text fullwidth" placeholder="https://example.com">';
            form += '</div>';
        } else {
            form += '<div class="field">';
            form += '<label>Link To</label>';
            form += '<div class="elementselect">';
            form += '<div class="elements"></div>';
            form += '<div class="btn add icon">Choose ' + type.charAt(0).toUpperCase() + type.slice(1) + '</div>';
            form += '</div>';
            form += '</div>';
        }
        
        // Common fields
        form += '<div class="field">';
        form += '<label>CSS Classes</label>';
        form += '<input type="text" name="nodes[' + index + '][classes]" class="text fullwidth" placeholder="my-class another-class">';
        form += '</div>';
        
        form += '<div class="field">';
        form += '<label><input type="checkbox" name="nodes[' + index + '][newWindow]" value="1"> Open in new window</label>';
        form += '</div>';
        
        form += '<div class="field">';
        form += '<label><input type="checkbox" name="nodes[' + index + '][enabled]" value="1" checked> Enabled</label>';
        form += '</div>';
        
        form += '</div>';
        
        return form;
    }
});
{% endjs %}

{% css %}
.navigation-builder {
    border: 1px solid #e3e5e8;
    border-radius: 3px;
    background: #fff;
}

.navigation-nodes {
    min-height: 200px;
    padding: 20px;
}

.navigation-node {
    margin-bottom: 10px;
    border: 1px solid #e3e5e8;
    border-radius: 3px;
    background: #fafafa;
}

.node-header {
    padding: 10px 15px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    background: #f9f9f9;
    border-bottom: 1px solid #e3e5e8;
}

.node-title {
    font-weight: 600;
}

.node-url {
    color: #8f98a3;
    font-size: 12px;
    margin-left: 10px;
}

.node-actions .btn {
    margin-left: 5px;
}

.node-form {
    padding: 15px;
    background: #fff;
}

.node-form-fields .field {
    margin-bottom: 15px;
}

.node-form-fields label {
    display: block;
    margin-bottom: 5px;
    font-weight: 600;
}

.navigation-actions {
    padding: 15px;
    border-top: 1px solid #e3e5e8;
    background: #fafafa;
}

.navigation-actions .btn-group .btn {
    margin-right: 10px;
}
{% endcss %}