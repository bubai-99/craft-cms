{
    "name": "mycompany/simple-menu",
    "description": "A simple, working menu management plugin for Craft CMS",
    "type": "craft-plugin",
    "version": "1.0.0",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "menu"
    ],
    "support": {
        "docs": "https://github.com/mycompany/simple-menu/blob/master/README.md"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Craft CMS",
            "homepage": "https://craftcms.com/"
        }
    ],
    "require": {
        "craftcms/cms": "^5.0.0"
    },
    "autoload": {
        "psr-4": {
            "mycompany\\simplemenu\\": "src/"
        }
    },
    "extra": {
        "name": "Simple Menu",
        "handle": "simple-menu",
        "hasCpSettings": false,
        "hasCpSection": true,
        "changelogUrl": "https://github.com/mycompany/simple-menu/blob/master/CHANGELOG.md",
        "class": "mycompany\\simplemenu\\Plugin"
    }
}