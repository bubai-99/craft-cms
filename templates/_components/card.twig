{# Card Component Template #}
{% set cardClass = 'card' %}
{% if variant is defined %}
    {% set cardClass = cardClass ~ ' card--' ~ variant %}
{% endif %}

<article class="{{ cardClass }}">
    {% if image is defined and image %}
        <div class="card__image">
            <img src="{{ image.url }}" alt="{{ image.alt ?: title }}" loading="lazy">
        </div>
    {% endif %}
    
    <div class="card__content">
        {% if title is defined and title %}
            <h3 class="card__title">
                {% if url is defined and url %}
                    <a href="{{ url }}" class="card__link">{{ title }}</a>
                {% else %}
                    {{ title }}
                {% endif %}
            </h3>
        {% endif %}
        
        {% if excerpt is defined and excerpt %}
            <p class="card__excerpt">{{ excerpt }}</p>
        {% endif %}
        
        {% if date is defined and date %}
            <time class="card__date" datetime="{{ date|date('c') }}">
                {{ date|date('F j, Y') }}
            </time>
        {% endif %}
        
        {% if url is defined and url and showReadMore is defined and showReadMore %}
            <a href="{{ url }}" class="card__read-more">Read more</a>
        {% endif %}
    </div>
</article>