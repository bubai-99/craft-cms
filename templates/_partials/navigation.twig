{# 
  Navigation Partial Template with Tailwind
  Shows how to display menu-manager menus in frontend
#}

{# Method 1: Get nodes by navigation handle #}
{% set nodes = craft.menuManager.nodes('mainmenu').level(1).all() %}

<header class="bg-white shadow-sm sticky top-0 z-50 border-b border-gray-200">
  <div class="max-w-6xl mx-auto px-4">
    <div class="flex justify-between items-center h-16">
      {# Brand/Logo #}
      <div class="flex items-center">
        <a href="/" class="text-2xl font-bold text-gray-900 hover:text-primary-600 transition-colors">
          {{ siteName }}
        </a>
      </div>

      {# Desktop Navigation #}
      {% if nodes|length %}
        <nav class="hidden md:flex items-center space-x-1" role="navigation" aria-label="Main Navigation">
          {% for node in nodes %}
            <div class="relative group">
              <a href="{{ node.url }}" 
                 class="px-4 py-2 text-gray-700 font-medium hover:text-primary-600 transition-colors rounded-md hover:bg-gray-50 {{ node.active ? 'text-primary-600 bg-primary-50' : '' }}"
                 {{ node.newWindow ? 'target="_blank" rel="noopener"' }}
                 {{ node.classes ? 'class="' ~ node.classes ~ '"' }}>
                {{ node.title }}
              </a>
              
              {# Desktop Dropdown #}
              {% if node.children|length %}
                <div class="absolute top-full left-0 mt-1 bg-white shadow-lg rounded-lg border border-gray-200 min-w-[200px] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                  <div class="py-2">
                    {% for child in node.children %}
                      <a href="{{ child.url }}" 
                         class="block px-4 py-2 text-gray-600 hover:text-primary-600 hover:bg-gray-50 transition-colors {{ child.active ? 'text-primary-600 bg-primary-50' : '' }}"
                         {{ child.newWindow ? 'target="_blank" rel="noopener"' }}
                         {{ child.classes ? 'class="' ~ child.classes ~ '"' }}>
                        {{ child.title }}
                      </a>
                    {% endfor %}
                  </div>
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </nav>
      {% endif %}

      {# Mobile menu button #}
      <button class="md:hidden flex flex-col space-y-1 p-2 rounded-md hover:bg-gray-100 mobile-menu-toggle" 
              onclick="toggleMobileMenu()">
        <span class="w-6 h-0.5 bg-gray-600 transition-all duration-300"></span>
        <span class="w-6 h-0.5 bg-gray-600 transition-all duration-300"></span>
        <span class="w-6 h-0.5 bg-gray-600 transition-all duration-300"></span>
      </button>
    </div>

    {# Mobile Navigation Menu #}
    {% if nodes|length %}
      <nav class="md:hidden mobile-nav hidden border-t border-gray-200" id="mobile-nav">
        <div class="py-4 space-y-2">
          {% for node in nodes %}
            <div>
              <a href="{{ node.url }}" 
                 class="block px-4 py-2 text-gray-700 font-medium hover:text-primary-600 hover:bg-gray-50 rounded-md transition-colors {{ node.active ? 'text-primary-600 bg-primary-50' : '' }}"
                 {{ node.newWindow ? 'target="_blank" rel="noopener"' }}
                 {{ node.classes ? 'class="' ~ node.classes ~ '"' }}>
                {{ node.title }}
              </a>
              
              {# Mobile Submenu #}
              {% if node.children|length %}
                <div class="ml-4 mt-2 space-y-1">
                  {% for child in node.children %}
                    <a href="{{ child.url }}" 
                       class="block px-4 py-2 text-sm text-gray-600 hover:text-primary-600 hover:bg-gray-50 rounded-md transition-colors {{ child.active ? 'text-primary-600 bg-primary-50' : '' }}"
                       {{ child.newWindow ? 'target="_blank" rel="noopener"' }}
                       {{ child.classes ? 'class="' ~ child.classes ~ '"' }}>
                      {{ child.title }}
                    </a>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </nav>
    {% else %}
      {# Show message when no menu exists yet #}
      <div class="p-4 bg-yellow-50 border border-yellow-200 rounded-lg my-4">
        <p class="m-0 text-yellow-800 text-sm">No navigation menu found. Please create a navigation called "mainmenu" in the Control Panel.</p>
      </div>
    {% endif %}
  </div>
</header>

<script>
function toggleMobileMenu() {
  const toggle = document.querySelector('.mobile-menu-toggle');
  const nav = document.getElementById('mobile-nav');
  
  toggle.classList.toggle('active');
  nav.classList.toggle('hidden');
}
</script>

