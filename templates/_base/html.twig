<!DOCTYPE html>
<html lang="{% block lang %}en-GB{% endblock %}">
	<head>
		{% block head %}
			<meta http-equiv="X-UA-Compatible" content="IE=edge" />
			<meta charset="utf-8" />
			<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
			<meta name="referrer" content="origin-when-cross-origin" />

			{% block seo %}
				{% hook "seo" %}
			{% endblock %}
			{% block structured_data %}
				{% hook "structuredData" %}
			{% endblock %}

			{% block favicon %}
				{% if favicon is defined and favicon %}
					{% set url = favicon.getUrl('icon') %}
					<link rel="icon shortcut" href="{{ url }}">
					<link rel="icon" href="{{ url }}">
					<link rel="apple-touch-icon" href="{{ url }}">
				{% endif %}
			{% endblock %}

			{% block head_extra %}
			{% endblock %}
	    {% endblock %}
	</head>
	{% block body %}
	{% endblock %}
</html>
