{% import '_includes/_partials/ctaButton' as buttons %}

{% if standardBannerSliders | length  > 0 %}
<section class="position-relative top-0 start-0 py-0 w-100" data-bs-theme="dark">
	<!-- Background image slider -->
	<div class="swiper swiper-scale-effect min-vh-100x" data-swiper-options='{
	  "effect": "fade",
	  "speed": 800,
	  "autoplay": {
		"delay": 7000,
		"disableOnInteraction": false
	  },
	  "pagination": {
		"el": ".swiper-pagination",
		"clickable": true
	  }
	}'>
	  <div class="swiper-wrapper">
		{% for standardBannerSlider in standardBannerSliders %}
		{% set heroBannerSliderHeading = standardBannerSlider.plainText %}
		{% set heroBannerSliderDisplayTitle = standardBannerSlider.displayTitle %}
		{% set heroBannerSliderSubtitle = standardBannerSlider.subtitle %}
		{% set heroBannerSliderSwitchOffDes = standardBannerSlider.switchOffDes %}
		{% set heroBannerSliderDescription = standardBannerSlider.shortDescription %}
		{% set heroBannerSliderImageVideo = standardBannerSlider.imageVideo %}
		{% if standardBannerSlider.image is defined and standardBannerSlider.image is not empty %}
				{% set heroBannerSliderImage = standardBannerSlider.image.one() %}
		{% endif %}

			<div class="swiper-slide py-5 jarallax h-fill-available">
				<div class="position-absolute top-0 start-0 w-100 h-100 z-2 bg-black opacity-60"></div>

				{% set heroBannerSliderImageVideoFile = heroBannerSliderImageVideo.one() %}
				{% if heroBannerSliderImageVideoFile %}
					<div class="swiper-slide-coverx jarallax-img  bg-position-center-center" style="background-image: url('{{ heroBannerSliderImageVideoFile.url }}');"></div>
				{% endif %}

				<div class="jarallax-img" style="background-image: url(assets/img/services/v3/hero-bg.jpg);"></div>

				<div class="container position-relative z-2 pt-5 pb-md-2 pb-lg-3 pb-xl-4 pb-xxl-5 text-{{ standardBannerSlider.textAlign.value }}">
					<!-- Page title -->
					<div class="d-none d-xxl-block" style="height: 170px;"></div>
					<div class="d-none d-lg-block d-xxl-none" style="height: 120px;"></div>
					<div class="d-none d-md-block d-lg-none" style="height: 80px;"></div>
					<div class="d-md-none" style="height: 40px;"></div>
					<h{{ standardBannerSlider.bannerHeadingTags.value }} class="display-{{ standardBannerSlider.bannerHeadingTags.value }} mb-4">{{heroBannerSliderHeading}}</h{{ standardBannerSlider.bannerHeadingTags.value }}>
					{% if heroBannerSliderDescription|length %}
						<div class="text-body mb-0">{{ heroBannerSliderDescription }}</div>
					{% endif %}
				</div>
			</div>

	{% endfor %}
	</div>
	<div class="swiper-pagination mb-4"></div>
</div>

</section>

{% endif %}
