{% import '_includes/_partials/ctaButton' as buttons %}

{% if heroBannerSliders | length  > 0 %}
	<section
		class="container-fluid py-2 px-sm-4 px-md-5   position-relative">
		<!-- Background image slider -->

		{% for heroBannerSlider in heroBannerSliders %}
			{% set heroBannerSliderHeading = heroBannerSlider.heading %}
			{% set heroBannerSliderDisplayTitle = heroBannerSlider.displayTitle %}
			{% set heroBannerSliderSubtitle = heroBannerSlider.subtitle %}
			{% set heroBannerSliderSwitchOffDes = heroBannerSlider.switchOffDes %}
			{% set heroBannerSliderDescription = heroBannerSlider.description %}
			{% set heroBannerSliderImageVideo = heroBannerSlider.imageVideo %}
			{% set heroBannerSliderImage = heroBannerSlider.image.one() %}
			{% set heroBannerSliderColorData = heroBannerSlider.colorLibrary.one() %}
			{% set heroBannerSliderColor = heroBannerSliderColorData.plainText ?? null %}
			{% set heroBannerSliderColorCode = heroBannerSliderColorData.colorcode ?? null %}
			{% set heroBannerSliderButton = heroBannerSlider.button %}
			{% set heroBannerSliderStyles = heroBannerSliderColorCode ? 'background-color: ' ~ heroBannerSliderColorCode ~ ' !important;' : '' %}
			{% set heroBannerSliderStyles = (heroBannerSliderImage and heroBannerSliderImage.url) ? heroBannerSliderStyles ~ 'background-image: url(\'' ~ heroBannerSliderImage.url ~ '\'); background-size: cover; ' : heroBannerSliderStyles %}
			{% set heroBannerSliderDisplayCheckList = heroBannerSlider.displayCheckList ?? null %}
			{% set heroBannerSliderCheckListShow = heroBannerSlider.checkListShowTable ?? null %}
			{% set heroBannerSliderIntroduction = heroBannerSlider.introduction ?? null %}


			<div class="bg-darkx rounded-5 position-relative overflow-hidden py-5 px-3 px-sm-4 px-xl-5 mx-md-n3 mx-lg-auto" style="max-width: 1660px; background-color: {{ heroBannerSliderColorCode }} !important;" data-bs-theme="dark">
				<div class="jarallax position-absolute top-0 start-0 w-100 h-100 mt-5" data-jarallax data-speed="0.6">
					<div class="jarallax-img position-absolute w-100 h-100" style="background-image: url('{{ heroBannerSliderImageVideo.0.url }}');"></div>
				</div>
				<div class="bg-white position-absolute top-0 start-0 w-100 h-100" style="opacity: 2%;"></div>
				<div class="container position-relative z-2 pt-xl-4 pt-xxl-5 pb-sm-2">
					<div class="row pt-md-3 pt-lg-5">
						<div class="col-lg-6 col-xxl-5 pb-lg-5 mb-xl-5">
							<h2 class="display-1 text-center text-lg-start mb-xxl-5">
								{{heroBannerSliderHeading}}
							</h2>
						</div>
						<div class="col-lg-5 col-xl-5 offset-lg-1 offset-xxl-2 d-flex flex-column pt-2 pt-md-4">
							<div class="text-body fs-xl text-center text-lg-start pb-2 pb-md-0 mb-4 mb-md-4">
								{% if heroBannerSliderSwitchOffDes %}
									<div class="text-body fs-xl pb-2 pb-md-0 mb-3" >
										{{ heroBannerSliderDescription }}
									</div>
								{% endif %}
								</div>
							<div class="d-flex flex-column flex-sm-row align-items-center justify-content-center justify-content-lg-start pb-3 pb-sm-5">
								{{ buttons.renderButton(heroBannerSliderButton) }}
							</div>
							{% if heroBannerSliderDisplayCheckList is defined and heroBannerSliderDisplayCheckList  and heroBannerSliderCheckListShow | length > 0 %}
								<ul class="list-inline d-xl-flex text-center text-lg-start mt-auto mb-0 mb-sm-2 flex-wrap">
									{% for checkListShow in heroBannerSliderCheckListShow %}
										<li class="d-inline-flex align-items-center text-body text-nowrap pt-1 col-md-6">
											{% if checkListShow.iconClass is defined and checkListShow.iconClass %}
												<i class="text-primary fs-xl me-2 {{ checkListShow.iconClass }}"></i>
											{% endif %}
											{% if checkListShow.title is defined and checkListShow.title %}
												{{ checkListShow.title }}
											{% endif %}
										</li>
									{% endfor %}
								</ul>
							{% endif %}
						</div>
					</div>
				</div>
			</div>

		{% endfor %}


	</section>

{% endif %}
