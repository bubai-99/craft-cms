<div class="matrix-row">
	{% set fieldValues = matrixRow.getFieldValues(matrixRow.getFieldLayout().customFields|map(f => f.handle)) %}

	{% for fieldHandle, fieldValue in fieldValues %}
		{% if fieldValue is iterable and fieldValue|length %}
		 {# 	{% for item in fieldValue.all() %} #}
				<div
					class="matrix-{{ fieldHandle }}">
					{#  {% include ["_includes/matrix-blocks/" ~ fieldHandle, "_includes/matrix-blocks/default"] with { block: item } %} #}
                    			EntryTYPEs >>
			{{ fieldHandle }}
				 {% include ["_includes/matrix-blocks/" ~ fieldHandle] with { block: fieldValue } %}
				</div>
		{# 	{% endfor %} #}
		{% endif %}
	{% endfor %}
</div>

