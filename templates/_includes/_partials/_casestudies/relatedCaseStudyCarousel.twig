{% if generalEntry.relatedCaseStudies | length %}
	{% set relatedCaseStudies = craft.entries().section('casestudies').id('not ' ~ entry.id).orderBy('postDate DESC').all() %}
	{% if relatedCaseStudies | length %}
		<div class="d-flex align-items-center pb-3 mb-3 mb-lg-4 mt-2 mt-xxl-3">
			<h2 class="w-100 h2 mb-0 text-{{ generalEntry.caseStudytextAlign.value }}" style="color: {{ generalEntry.caseStudyTitleColor.one().colorcode ?? '' }}">Related Case Studies</h2>
		</div>

		<div class="swiper" data-swiper-options='
				{
				"spaceBetween": 24,
				"pagination": {
					"el": ".swiper-pagination",
					"clickable": true
				},
				"breakpoints": {
					"576": { "slidesPerView": 2 },
					"992": { "slidesPerView": {{ generalEntry.caseStudiesColumnPerRow.value }} }
				},
				"autoplay": {
					"delay": 3000,
					"disableOnInteraction": false
				},
				"speed": 1000,
				"loop": true
				}
			'>
			<div class="swiper-wrapper">
				{% for caseStudy in relatedCaseStudies %}
					{% include "_includes/_partials/_casestudies/singleCaseStudyInSlider.twig" with { caseStudy: caseStudy } %}
				{% endfor %}
			</div>
		</div>
	{% endif %}
{% endif %}
