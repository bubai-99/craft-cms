{% import '_helpers/images' as images %}

<div class="swiper-slide h-auto pb-1">
	<div class="card-hover position-relative bg-secondary rounded-1 p-0 mb-4 overflow-hidden">
		{% if product.tags|length %}
			<span class="badge bg-danger bg-opacity-10 text-danger position-absolute top-0 start-0 mt-3 ms-3">
				{% set tags = product.tags.all() %}
				{% if tags %}
					{% for tag in tags %}
						{{ tag.title }}
					{% endfor %}
				{% endif %}
			</span>
		{% endif %}

		{% if product.image|length %}
			<a href="{{ product.url }}" class="d-block">
				{{ images.singleImg(product.image.0, 310, {'ratio': 0.8100}, 'flex-shrink-0 w-100 card-img-top') }}
			</a>
		{% endif %}
	</div>
	<div class="row">
		<div class="col-8">
			<div class="d-flex mb-1">
				<h3 class="h6 mb-0">
					<a href="{{ product.url }}">{{ product.title }}</a>
				</h3>
			</div>
			<div class="d-flex align-items-center">
				<span class="me-2">{{ product.discountPrice }}</span>
				<del class="fs-sm text-body-secondary">{{ product.price }}</del>
			</div>
		</div>
		<div class="col-4 d-flex align-items-end justify-content-end">
			<a href="{{ product.url }}" class="btn btn-outline-primary btn-sm">View</a>
			{# {{ buttons.renderButton(productButton) }} #}
		</div>
	</div>
</div>
