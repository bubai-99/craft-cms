{% set categories = craft.categories().group('blogCategories').status('enabled').all() %}
{% set entryQuery = craft.entries().section('blogs').status('enabled') %}

<div class="row mb-4">
	<div class="col-12">
		<div class="bg-secondary p-3 rounded-2 border">
			<form name="blogSearch" id="blogSearch" action="/blogs" method="GET">
				<div class="row gy-2 gx-3">
					<div class="col-lg-8 col-sm-5">
						<div class="position-relative">
							<i class="ai-search position-absolute top-50 start-0 translate-middle-y ms-3"></i>
							<input class="form-control ps-5 bg-light" type="search" name="search" placeholder="Enter keyword" value="{{ searchParams|trim }}">
						</div>
					</div>
					<div class="col-xl-3 col-lg-3 col-sm-5">
						<select name="category" class="form-select bg-light" onchange="this.form.submit()">
							<option value="">All categories</option>
							{% if categories | length %}
								{% for category in categories %}
									<option value="{{ category.slug }}" {{ selectedCategory and selectedCategory == category.slug ? 'selected' : '' }}>{{ category.title | raw }}</option>
								{% endfor %}
							{% endif %}
						</select>
					</div>
					<div class="col-lg-1 col-sm-2 text-sm-end">
						<a href="/blogs" class="btn btn-dark w-100">
							Reset
						</a>
					</div>
				</div>
			</form>
		</div>
	</div>
</div>
