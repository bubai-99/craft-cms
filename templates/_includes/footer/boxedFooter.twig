{% import "_helpers/images" as images %}
{% import '_helpers/utils' as utils %}
{% import '_includes/_partials/ctaButton' as buttons %}
<!-- Footer -->
<style>
	.last-0 > *:last-child {
		margin-bottom: 0;
	}
</style>
<div class="container-fluid px-md-5 pt-4 pb-2 pb-md-5 pt-sm-5">
	<div class="rounded-5 position-relative overflow-hidden w-100 px-3 px-sm-4 px-xl-5 mx-auto footer-main py-5 {{ footerClasses }}" style="max-width: 1660px;" {% if themeSwitche %} data-bs-theme="dark" {% else %} data-bs-theme="light" {% endif %}>
		<div class="container position-relative z-2 pt-md-3 pt-lg-4 pt-xl-5 pb-2">
			<div class="row pb-2">
				<div class="col-lg-4 col-xxl-3 pb-2 pb-lg-0 mb-4 mb-lg-0">
					<div class="navbar-brand text-light py-0 me-0 pb-1 mb-3">
						{% if footerDisplayLogo %}
							<a class="navbar-brand text-light py-0 me-0 pb-1 mb-3" href="/">
								<span class="text-primary flex-shrink-0 me-2">
									<img src="{{ generalEntry.logo.0.url }}" alt="logo">
								</span>
							</a>
						{% endif %}
					</div>
					{% if footer.description %}
						<div class="text-body fs-sm mb-4">{{ footer.description }}</div>
					{% endif %}
					{% if footerDisplaySubscribe %}
						<div class="input-group input-group-sm rounded-pill">
							<input class="form-control" type="text" placeholder="Email address">
							<button class="btn btn-primary rounded-pill" type="button">Subscribe</button>
						</div>
					{% endif %}
				</div>
				<div class="col-sm-4 col-lg-2 offset-lg-1 offset-xl-2 offset-xxl-3 mb-4 mb-sm-0">
					<h6 class="fw-bold text-body">Page links</h6>
					{{ craft.simplerpmenu.getRpMenuHTML('company',{ 'menu-id': 'company','menu-class':'','ul-class':'nav flex-column fs-sm','li-class':'nav-item'}) }}
				</div>
				<div class="col-sm-4 col-lg-2 mb-4 mb-sm-0">
					<h6 class="fw-bold text-body">Useful links</h6>
					{{ craft.simplerpmenu.getRpMenuHTML('support',{ 'menu-id': 'support','menu-class':'','ul-class':'nav flex-column fs-sm','li-class':'nav-item'}) }}
				</div>
				<div class="col-sm-4 col-lg-3 col-xl-2">
					{% if footerDisplayContactInfo %}
						<h6 class="fw-bold text-body">Contact Info</h3>
						<div>
							<ul class="nav flex-column fs-sm">
								{% if generalEntry.Description %}
									<li class="nav-item text-body last-0 mb-3">
										{{ generalEntry.Description }}
									</li>
								{% endif %}
								{% if generalEntry.email %}
									<li class="nav-item">
										<a class="nav-link fw-normal px-0 py-1" href="mailto:{{ generalEntry.email }}">{{ generalEntry.email }}</a>
									</li>
								{% endif %}
								<li class="nav-item">
									<a class="nav-link fw-normal px-0 py-1" href="tel:{{ generalEntry.phoneNumber }}">{{ generalEntry.phoneNumber }}</a>
								</li>
							</ul>
						</div>
					{% endif %}
				</div>
			</div>
			<div class="d-sm-flex align-items-center justify-content-between pt-4 pt-md-5 mt-2 mt-md-0 mt-lg-2 mt-xl-4">
				<div class="d-flex order-sm-2 me-md-n2">
					{% if footerDisplaySocial %}
						{% include '_includes/_partials/social' %}
					{% endif %}
				</div>
				<p class="nav fs-sm order-sm-1 text-center text-sm-start pt-4 pt-sm-0 mb-0 me-4">
					<span class="text-body-secondary">© All rights reserved. Made by</span>
					<a class="nav-link d-inline fw-normal p-0 ms-1" href="https://remoteprogrammer.com/" target="_blank" rel="noopener">RP</a>
				</p>
			</div>
		</div>
	</div>
</div>

<!-- Back to top button -->
<a class="btn-scroll-top" href="#top" data-scroll aria-label="Scroll back to top">
	<svg viewbox="0 0 40 40" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
		<circle cx="20" cy="20" r="19" fill="none" stroke="currentColor" stroke-width="1.5" stroke-miterlimit="10"></circle>
	</svg>
	<i class="ai-arrow-up"></i>
</a>
{# {{ adminBar({ 
	entry: entry,
	position: 'bottom',
	fixed: 'true',
}) }} #}
