{% import "_helpers/images" as images %}
{% import '_helpers/utils' as utils %}
{% import '_includes/_partials/ctaButton' as buttons %}
<!-- Footer -->
<style>
	.last-0 > *:last-child {
		margin-bottom: 0;
	}
</style>
<div class="footer footer-main py-5 {{ footerClasses }}" {% if themeSwitche %} data-bs-theme="dark" {% else %} data-bs-theme="light" {% endif %}>
	<div class="{{ footerContainerWidth }}">
		<div class="row pb-4 pb-md-5 pt-sm-2 mb-lg-2 border-bottom {{ footerVerticalAlign }}">
			<div class="col-md-4 col-lg-3 pb-2 pb-md-0 mb-4 mb-md-0">
				{% if footerDisplayLogo %}
					<a class="navbar-brand text-light py-0 me-0 pb-1 mb-3" href="/">
						<span class="text-primary flex-shrink-0 me-2">
							<img src="{{ generalEntry.logo.0.url }}" alt="logo">
						</span>
					</a>
				{% endif %}
				{% if footer.description %}
					<div class="text-body fs-sm mb-4">{{ footer.description }}</div>
				{% endif %}
				<!-- CTA Button -->
				{% if footerDisplayCTA is defined and footerButton is defined and footerDisplayCTA  and footerButton %}
					{% set customClasses = "btn-sm fs-sm mb-3" %}
					{{ buttons.renderButton(footerButton, {}, customClasses) }}
				{% endif %}

				{% if footerDisplayOfficeTiming and officeTiming and officeTiming|length > 0 %}
					<div class="mt-3">
						<h3 class="h6">Office Timeing</h3>
						<ul class="list-unstyled mb-0 pb-3 pb-md-0">
							{% for officeTime in officeTiming %}
								<li class="text-light opacity-90 mb-2">{{officeTime.day}}
									{{ utils.formatTime24Hour(officeTime.startTime) }}
									-
									{{ utils.formatTime24Hour(officeTime.endTime) }}
								</li>
							{% endfor %}
						</ul>
					</div>
				{% endif %}
			</div>
			<div class="col-md-10 col-lg-7 ms-lg-auto">
				<div class="row row-cols-1 row-cols-sm-3">
					<div class="col mb-3 mb-md-0">
						<h3 class="h6">Page links</h3>
						{{ craft.simplerpmenu.getRpMenuHTML('company',{ 'menu-id': 'company','menu-class':'','ul-class':'nav flex-column fs-sm','li-class':'nav-item'}) }}
					</div>
					<div class="col mb-4 mb-md-0">
						<h3 class="h6">Useful links</h3>
						{{ craft.simplerpmenu.getRpMenuHTML('support',{ 'menu-id': 'support','menu-class':'','ul-class':'nav flex-column fs-sm','li-class':'nav-item'}) }}
					</div>

					<div class="col">
						{% if footerDisplayContactInfo %}
							<h3 class="h6">Contact Info</h3>
							<div>
								<ul class="nav flex-column fs-sm">
									{% if generalEntry.Description %}
										<li class="nav-item text-body last-0 mb-1">
											{{ generalEntry.Description }}
										</li>
									{% endif %}
									{% if generalEntry.email %}
										<li class="nav-item">
											<a class="nav-link fw-normal px-0 py-1" href="mailto:{{ generalEntry.email }}">{{ generalEntry.email }}</a>
										</li>
									{% endif %}
									<li class="nav-item">
										<a class="nav-link fw-normal px-0 py-1" href="tel:{{ generalEntry.phoneNumber }}">{{ generalEntry.phoneNumber }}</a>
									</li>
								</ul>
							{% endif %}

						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="d-sm-flex align-items-center justify-content-between pt-4 mt-2 mt-sm-0">
			<div class="d-flex justify-content-center gap-3 order-sm-2 mb-4 mb-sm-0">
				{% if footerDisplaySocial %}
					{% include '_includes/_partials/social' %}
				{% endif %}
			</div>

			<p class="nav fs-sm order-sm-1 justify-content-center mb-0">
				<span class="text-body-secondary">© All rights reserved. Made by</span>
				<a class="nav-link d-inline fw-normal p-0 ms-1" href="https://remoteprogrammer.com/" target="_blank" rel="noopener">RP</a>
			</p>
		</div>
	</div>
</div>

<!-- Back to top button -->
<a class="btn-scroll-top" href="#top" data-scroll aria-label="Scroll back to top">
	<svg viewbox="0 0 40 40" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
		<circle cx="20" cy="20" r="19" fill="none" stroke="currentColor" stroke-width="1.5" stroke-miterlimit="10"></circle>
	</svg>
	<i class="ai-arrow-up"></i>
</a>
{# {{ adminBar({ 
	entry: entry,
	position: 'bottom',
	fixed: 'true',
}) }} #}
