{% import "_helpers/images" as images %}
{% set headingAndContent = block.headingAndContent.one() %}
{% set selectTestimonials = block.selectTestimonials ?? [] %}
{% set blockStyle = block.blockStyle ?? [] %}
{% set blockType = block.type.handle ?? '' %}
{% set blockTypeUid = block.uid  ?? '' %}

{% set containerWidth = 'container' %}
{% set title = block.title ?? '' %}
{% set heading = block.heading ?? '' %}
{% set headingTags = block.headingTags ?? 'h2' %}
{% set align = block.align ?? 'left' %}
{% set contentData = block.contentdata ?? '' %}

{% set blockCssClasses = '' %}
{% set themeSwitche = '' %}

{% if selectTestimonials %}
	{% if blockStyle is defined and blockStyle|length %}
		{% set blockStyleData = blockStyle.one() %}
		{% set blockCssClasses = blockStyleData.cssClasses ?? '' %}
		{% include "_includes/matrix-blocks/blockStyle" with { blockStyle: blockStyleData, blockType: blockType } %}

		{% if blockStyleData.containerWidth is defined and blockStyleData.containerWidth.value|length %}
			{% set containerWidthMap = {
				'default': 'container',
				'fullWidth': 'container container-full',
				'boxedLg': 'container container-large',
				'boxedSm': 'container container-small'
			} %}
			{% set containerWidth = containerWidthMap[blockStyleData.containerWidth.value] ?? 'container' %}

			{% if blockStyleData.background is defined and blockStyleData.background.themeDark is defined %}
				{% set themeSwitche = blockStyleData.background.one().themeDark ?? null %}
			{% endif %}
	{% endif %}
{% endif %}


<div class="py-3 py-lg-4 py-xl-5 {{ blockType }}{{blockTypeUid}}-style">
	<div class="{{ containerWidth }}">
		{% if headingAndContent %}
			{% if headingAndContent.heading|length or headingAndContent.Description|length %}
			<div class="header-content-block pb-3 pb-lg-4 {{ blockCssClasses }} {{ blockType }}-style"
				data-bs-theme="{{ themeSwitche ? 'dark' : 'light' }}">
				{% if headingAndContent.heading|length %}
				<{{headingAndContent.headingTags}} class="block-heading-title"
					style="text-align:{{ headingAndContent.align }}">{{ headingAndContent.heading }}
				</{{headingAndContent.headingTags}}>
				{% endif %}
				{% if headingAndContent.Description|length %}
				<div class="block-description">{{ headingAndContent.Description }}</div>
				{% endif %}
			</div>
			{% endif %}
		{% endif %}


		{% set displayView = block.displayView.value ?? '' %}
		{% if displayView == 'gridView' %}

			<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-{{ block.testimonialPerRow.value }} g-4">
				{% for testimonial in selectTestimonials %}
				<div class="col">
					<div class="card border-0 bg-secondary">
                        <div class="card-body">
                          <div class="d-flex align-items-center mb-3">
                            {% if testimonial.image|length %}
                            <div class="pe-3">
                                {{ images.singleImg(testimonial.image.0, 60, {'ratio': 1}, 'flex-shrink-0 w-100 rounded-circle') }}
                            </div>
                            {% endif %}
                            
                            <div>
                              <div class="h6 mb-0 lh-1">{{ testimonial.authorName }}</div>
                              <div class="fs-sm text-body-secondary">{{ testimonial.authorRole }}</div>
                              <div class="">
                                {% switch testimonial.ratings %}
                                    {% case '1' %}
                                        <i class="ai-star-filled"></i>
                                        <i class="ai-star"></i>
                                        <i class="ai-star"></i>
                                        <i class="ai-star"></i>
                                        <i class="ai-star"></i>
                                    {% case '2' %}
                                        <i class="ai-star-filled"></i>
                                        <i class="ai-star-filled"></i>
                                        <i class="ai-star"></i>
                                        <i class="ai-star"></i>
                                        <i class="ai-star"></i>
                                    {% case '3' %}
                                        <i class="ai-star-filled"></i>
                                        <i class="ai-star-filled"></i>
                                        <i class="ai-star-filled"></i>
                                        <i class="ai-star"></i>
                                        <i class="ai-star"></i>
                                    {% case '4' %}
                                        <i class="ai-star-filled"></i>
                                        <i class="ai-star-filled"></i>
                                        <i class="ai-star-filled"></i>
                                        <i class="ai-star-filled"></i>
                                        <i class="ai-star"></i>
                                    {% case '5' %}
                                        <i class="ai-star-filled"></i>
                                        <i class="ai-star-filled"></i>
                                        <i class="ai-star-filled"></i>
                                        <i class="ai-star-filled"></i>
                                        <i class="ai-star-filled"></i>
                                    {% default %}
                                        <i class="ai-star"></i>
                                        <i class="ai-star"></i>
                                        <i class="ai-star"></i>
                                        <i class="ai-star"></i>
                                        <i class="ai-star"></i>
                                {% endswitch %}
                              </div>
                            </div>
                          </div>
                          <p class="card-text">{{ testimonial.comment }}</p>
                        </div>
                      </div>
				</div>

				{% endfor %}
			</div>

		{% endif %}

		{% if displayView == 'sliderView' %}

			<div class="swiper" data-swiper-options='
				{
				"spaceBetween": 24,
				"pagination": {
					"el": ".swiper-pagination",
					"clickable": true
				},
				"breakpoints": {
					"576": { "slidesPerView": 2 },
					"992": { "slidesPerView": {{ block.testimonialPerRow.value }} }
				}
				}
			'>
				<div class="swiper-wrapper">
					{% for testimonial in selectTestimonials %}
					<div class="swiper-slide h-auto">
						<div class="card border-0 bg-secondary">
                            <div class="card-body">
                              <div class="d-flex align-items-center mb-3">
                                {% if testimonial.image|length %}
                                <div class="pe-3">
                                    {{ images.singleImg(testimonial.image.0, 60, {'ratio': 1}, 'flex-shrink-0 w-100 rounded-circle') }}
                                </div>
                                {% endif %}
                                
                                <div>
                                  <div class="h6 mb-0 lh-1">{{ testimonial.authorName }}</div>
                                  <div class="fs-sm text-body-secondary">{{ testimonial.authorRole }}</div>
                                  <div>
                                    {% switch testimonial.ratings %}
                                        {% case '1' %}
                                            <i class="ai-star-filled"></i>
                                            <i class="ai-star"></i>
                                            <i class="ai-star"></i>
                                            <i class="ai-star"></i>
                                            <i class="ai-star"></i>
                                        {% case '2' %}
                                            <i class="ai-star-filled"></i>
                                            <i class="ai-star-filled"></i>
                                            <i class="ai-star"></i>
                                            <i class="ai-star"></i>
                                            <i class="ai-star"></i>
                                        {% case '3' %}
                                            <i class="ai-star-filled"></i>
                                            <i class="ai-star-filled"></i>
                                            <i class="ai-star-filled"></i>
                                            <i class="ai-star"></i>
                                            <i class="ai-star"></i>
                                        {% case '4' %}
                                            <i class="ai-star-filled"></i>
                                            <i class="ai-star-filled"></i>
                                            <i class="ai-star-filled"></i>
                                            <i class="ai-star-filled"></i>
                                            <i class="ai-star"></i>
                                        {% case '5' %}
                                            <i class="ai-star-filled"></i>
                                            <i class="ai-star-filled"></i>
                                            <i class="ai-star-filled"></i>
                                            <i class="ai-star-filled"></i>
                                            <i class="ai-star-filled"></i>
                                        {% default %}
                                            <i class="ai-star"></i>
                                            <i class="ai-star"></i>
                                            <i class="ai-star"></i>
                                            <i class="ai-star"></i>
                                            <i class="ai-star"></i>
                                    {% endswitch %}
                                  </div>
                                </div>
                              </div>
                              <p class="card-text">{{ testimonial.comment }}</p>
                            </div>
                          </div>
					</div>
					{% endfor %}
				</div>
				<!-- Pagination (bullets) -->
				<div class="swiper-pagination position-relative bottom-0 mt-2 pt-4"></div>
			</div>
		{% endif %}
	</div>
</div>

{% endif %}