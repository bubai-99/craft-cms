{% import "_helpers/images" as images %}
{% set selectTeams = block.selectTeamMembers ?? [] %}
{% set blockStyle = block.blockStyle ?? [] %}
{% set blockType = block.type.handle ?? '' %}
{% set blockTypeUid = block.uid  ?? '' %}
{# {% set serviceStyles = block.serviceStyle.one() %} #}

{% if selectTeams %}
	{% if blockStyle is defined and blockStyle|length %}
		{% set blockStyleData = blockStyle.one() %}
		{% set blockCssClasses = blockStyleData.cssClasses ?? '' %}
		{% include "_includes/matrix-blocks/blockStyle" with { blockStyle: blockStyleData, blockType: blockType } %}

		{% if blockStyleData.containerWidth is defined and blockStyleData.containerWidth.value|length %}
			{% set containerWidthMap = {
				'default': 'container',
				'fullWidth': 'container container-full',
				'boxedLg': 'container container-large',
				'boxedSm': 'container container-small'
			} %}
			{% set containerWidth = containerWidthMap[blockStyleData.containerWidth.value] ?? 'container' %}
		{% endif %}
	{% endif %}
	{% set displayMode = block.displayMode.value ?? '' %}

	

	<div class="py-3 py-lg-4 py-xl-5 {{ blockType }}{{blockTypeUid}}-style">
		<div class="{{ containerWidth }}">
			<h2 class="h1 text-center pb-3 pb-lg-4">{{ block.title }}</h2>
				<div class="swiper-wrapper">
					{% for team in selectTeams %}
	
						<!-- Item -->
						<div class="swiper-slide h-auto">
							<a class="card border-0 h-100 text-center text-decoration-none " href="#">
								<div class="card-body">
									{% if team.image|length %}
										<div class="d-block mx-auto mb-4">
											{{ images.singleImg(team.image.0, 196, {'ratio': 2.578}, 'flex-shrink-0') }}
										</div>
									{% endif %}
									<h3 class="service-heading-title">{{team.title}}</h3>
									<div class="card-text service-content-style">{{team.Description}}</div>
								</div>
								<div class="card-footer border-0 px-0 pt-0 pb-4 mb-3">
									<div class="btn btn-icon btn-outline-primary rounded-circle stretched-link">
										<i class="ai-arrow-right"></i>
									</div>
								</div>
							</a>
						</div>

					{% endfor %}
				</div>

				<!-- Pagination (bullets) -->
		</div>
	</div>


{% endif %}