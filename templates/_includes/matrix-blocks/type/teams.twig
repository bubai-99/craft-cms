{% import "_helpers/images" as images %}
{% set headingAndContent = block.headingAndContent.one() %}
{% set selectTeams = block.selectTeamMembers ?? [] %}
{% set blockStyle = block.blockStyle ?? [] %}
{% set blockType = block.type.handle ?? '' %}
{% set blockTypeUid = block.uid  ?? '' %}
{% set containerWidth = 'container' %}
{% set title = block.title ?? '' %}
{% set heading = block.heading ?? '' %}
{% set headingTags = block.headingTags ?? 'h2' %}
{% set align = block.align ?? 'left' %}
{% set contentData = block.contentdata ?? '' %}

{% set blockCssClasses = '' %}
{% set themeSwitche = '' %}

{% if selectTeams %}
	{% if blockStyle is defined and blockStyle|length %}
		{% set blockStyleData = blockStyle.one() %}
		{% set blockCssClasses = blockStyleData.cssClasses ?? '' %}
		{% include "_includes/matrix-blocks/blockStyle" with { blockStyle: blockStyleData, blockType: blockType } %}

		{% if blockStyleData.containerWidth is defined and blockStyleData.containerWidth.value|length %}
			{% set containerWidthMap = {
				'default': 'container',
				'fullWidth': 'container container-full',
				'boxedLg': 'container container-large',
				'boxedSm': 'container container-small'
			} %}
			{% set containerWidth = containerWidthMap[blockStyleData.containerWidth.value] ?? 'container' %}

			{% if blockStyleData.background is defined and blockStyleData.background.themeDark is defined %}
				{% set themeSwitche = blockStyleData.background.one().themeDark ?? null %}
			{% endif %}
	{% endif %}
{% endif %}


<div class="py-3 py-lg-4 py-xl-5 {{ blockType }}{{blockTypeUid}}-style">
	<div class="{{ containerWidth }}">
		{% if headingAndContent %}
			{% if headingAndContent.heading|length or headingAndContent.Description|length %}
			<div class="header-content-block pb-3 pb-lg-4 {{ blockCssClasses }} {{ blockType }}-style"
				data-bs-theme="{{ themeSwitche ? 'dark' : 'light' }}">
				{% if headingAndContent.heading|length %}
				<{{headingAndContent.headingTags}} class="block-heading-title"
					style="text-align:{{ headingAndContent.align }}">{{ headingAndContent.heading }}
				</{{headingAndContent.headingTags}}>
				{% endif %}
				{% if headingAndContent.Description|length %}
				<div class="block-description">{{ headingAndContent.Description }}</div>
				{% endif %}
			</div>
			{% endif %}
		{% endif %}


		{% set displayView = block.displayView.value ?? '' %}
		{% if displayView == 'gridView' %}
			<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-{{ block.teamMemberPerRow.value }} g-4">
				{% for team in selectTeams %}
				<div class="col">
					<div class="card card-hover border-0 rounded-5 overflow-hidden">
						{% if team.image|length %}
						<div>
							{{ images.singleImg(team.image.0, 415, {'ratio': 1}, 'flex-shrink-0 w-100') }}
						</div>
						{% endif %}
						<div class="position-absolute top-0 start-0 w-100 h-100 opacity-0">
							<div class="bg-dark position-absolute top-0 start-0 w-100 h-100 opacity-75"></div>
							<div class="card-body d-flex flex-column justify-content-end h-100 position-relative z-2 text-center"
								data-bs-theme="dark">
								<h3 class="h5 mb-1">{{team.title}}</h3>
								<p class="text-body mb-3">{{team.plainTextRole}}</p>
								<p class="text-body mb-3 d-flex align-items-center justify-content-center">
									<i class="ai-mail me-2"></i><a class="text-body text-decoration-none" href="mailto:{{team.email}}">{{team.email}}</a>
								</p>
								<div class="d-flex justify-content-center">

									{% set socialMedia = team.socialMedia.all() %}

									{% if socialMedia|length %}
									{% for social in socialMedia %}
									{% if social.iconClass|length %}
									<a class="btn btn-icon btn-sm btn-light rounded-circle mx-2 {{ social.elementClass }}"
										href="{{ social.linkUrl }}" aria-label="Instagram">
										<i class="{{ social.iconClass}}"></i>
									</a>
									{% endif %}
									{% if social.iconImage|length %}
									<a class="mx-2 {{ social.elementClass }}" href="{{ social.linkUrl }}"
										aria-label="Instagram">
										<img src="{{ social.iconImage.one().url }}" alt="">
									</a>
									{% endif %}
									{% endfor %}
									{% endif %}
								</div>

								<div class="card-footer border-0 px-0 pt-0 pb-4 mb-3">
									<a class="btn btn-outline-primary rounded-2 " href="{{ team.url }}">
										View Details
									</a>
								</div>				

							</div>
						</div>
					</div>
				</div>
				{% endfor %}
			</div>

		{% endif %}

		{% if displayView == 'sliderView' %}
			<div class="swiper" data-swiper-options='
				{
				"spaceBetween": 24,
				"pagination": {
					"el": ".swiper-pagination",
					"clickable": true
				},
				"breakpoints": {
					"576": { "slidesPerView": 2 },
					"992": { "slidesPerView": {{ block.teamMemberPerRow.value }} }
				}
				}
			'>
				<div class="swiper-wrapper">
					{% for team in selectTeams %}
					<div class="swiper-slide h-auto">
						<div class="card card-hover border-0 rounded-5 overflow-hidden">
							{% if team.image|length %}
							<div>
								{{ images.singleImg(team.image.0, 415, {'ratio': 1}, 'flex-shrink-0 w-100') }}
							</div>
							{% endif %}
							<div class="position-absolute top-0 start-0 w-100 h-100 opacity-0">
								<div class="bg-dark position-absolute top-0 start-0 w-100 h-100 opacity-75"></div>
								<div class="card-body d-flex flex-column justify-content-end h-100 position-relative z-2 text-center"
									data-bs-theme="dark">
									<h3 class="h5 mb-1">{{team.title}}</h3>
									<p class="text-body mb-3">{{team.plainTextRole}}</p>
									<p class="text-body mb-3"><a class="text-body text-decoration-none"
											href="mailto:{{team.email}}">{{team.email}}</a></p>
									<div class="d-flex justify-content-center">

										{% set socialMedia = team.socialMedia.all() %}

										{% if socialMedia|length %}
										{% for social in socialMedia %}
										{% if social.iconClass|length %}
										<a class="btn btn-icon btn-sm btn-light rounded-circle mx-2 {{ social.elementClass }}"
											href="{{ social.linkUrl }}" aria-label="Instagram">
											<i class="{{ social.iconClass}}"></i>
										</a>
										{% endif %}
										{% if social.iconImage|length %}
										<a class="mx-2 {{ social.elementClass }}" href="{{ social.linkUrl }}"
											aria-label="Instagram">
											<img src="{{ social.iconImage.one().url }}" alt="">
										</a>
										{% endif %}
										{% endfor %}
										{% endif %}
									</div>

									<div class="card-footer border-0 px-0 pt-0 pb-4 mb-3">
										<a class="btn btn-outline-primary rounded-2 " href="{{ team.url }}">
											View Details
										</a>
									</div>	
								</div>
							</div>
						</div>
					</div>
					{% endfor %}
				</div>
				<!-- Pagination (bullets) -->
				<div class="swiper-pagination position-relative bottom-0 mt-2 pt-4"></div>
			</div>
		{% endif %}
	</div>
</div>

{% endif %}