{% set spacingData = block.one() ?? null %}
{% if spacingData.mediaScreen is defined %}
	{% set mediaScreen = spacingData.mediaScreen ?? null %}
{% endif %}
{% set padding = spacingData.padding ?? null %}
{% set topPadding = padding[0].top ?? null %}
{% set rightPadding = padding[0].right ?? null %}
{% set bottomPadding = padding[0].bottom ?? null %}
{% set leftPadding = padding[0].left ?? null %}

{% set margin = spacingData.margin ?? null %}
