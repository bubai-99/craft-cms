{% import "_helpers/images" as images %}
{% import '_includes/_partials/ctaButton' as buttons %}

<div class="headerMain {{ headerClasses }} {{ headerPositioning }} sticky">
	{% if headerDisplayThinbar %}
		<div class="header-top bg-primary py-1 text-white">
			<div class="container text-center fs-sm">
				{{ generalEntry.headerNotification }}
			</div>
		</div>
	{% endif %}
	<!-- Navbar. Remove 'fixed-top' class to make the navigation bar scrollable with the page -->
	<div class="header-main navbar-dark position-relative" {% if themeSwitche %} data-bs-theme="dark" {% else %} data-bs-theme="light" {% endif %}>
		<div class="container-fluid h-100 header-container d-flex align-items-center justify-content-between">
			<div class="logo flex-shrink-0">
				<a href="#" class="navbar-brand">
					<span class="text-white flex-shrink-0 me-2">
						<img src="{{ generalEntry.logo.0.url }}" alt="logo">
					</span>
				</a>
			</div>
			<div class="d-flex align-items-center">
				<!-- Phone -->
				{% if headerDisplayPhone %}
					<div>
						<a class="nav-link fw-normal px-0 py-1" href="tel:{{ generalEntry.phoneNumber }}">{{ generalEntry.phoneNumber }}</a>
					</div>
				{% endif %}

				<nav class="navbar navbar-offcanvas navbar-dark">
					<button class="menu-icon navbar-toggler collapsed" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasRight" aria-label="Toggle navigation">
						<span class="navbar-toggler-icon"></span>
					</button>

					<div class="offcanvas  offcanvas-end bg-dark text-white" tabindex="-1" id="offcanvasRight" aria-labelledby="offcanvasRightLabel" aria-hidden="true">
						<div class="offcanvas-header justify-content-between py-2 py-xl-3 px-3 px-xl-4">
							<div class="offcanvas-title fw-bold" id="offcanvasRightLabel">
								<span class="text-white flex-shrink-0 me-2">
									<img src="{{ generalEntry.logo.0.url }}" alt="logo">
								</span>
							</div>
							<button type="button" class="btn text-white py-0 px-0 border-0" data-bs-dismiss="offcanvas" aria-label="Close">
								<span class="btn-close btn-close-white text-reset p-_5 m-0 opacity-100"></span>
								<span class="text ms-_5 text-capitalize fw-normal">Close</span>
							</button>
						</div>
						<div class="offcanvas-body pt-0 px-3 px-xl-4 h-100" id="navbarNav" data-simplebar>
							{{ craft.simplerpmenu.getRpMenuHTML('headerMenu',{ 
								'menu-id': 'headerMenu',
								'menu-class':'headerMenu',
								'ul-class':'navbar-nav navbar-nav-scroll me-auto px-1',
								'li-class':'nav-item',
								'sub-menu-ul-class':'list-unstyled mb-0',
								'link-class':'nav-link', }) 
							}}

							<!-- Phone -->
							{% if headerDisplayPhone %}
								<div class="mt-2 d-flex align-items-center">
									<i class="ai-phone me-2"></i>
									<a class="nav-link fw-normal px-0 py-1" href="tel:{{ generalEntry.phoneNumber }}">{{ generalEntry.phoneNumber }}</a>
								</div>
							{% endif %}

							<!-- Email -->
							{% if headerDisplayEmail %}
								<div class="mt-2 d-flex align-items-center">
									<i class="ai-mail me-2"></i>
									<a class="nav-link fw-normal px-0 py-1" href="mailto:{{ generalEntry.email }}">{{ generalEntry.email }}</a>
								</div>
							{% endif %}

						</div>
						<!-- Social -->
						{% if headerDisplaySocial %}
							<div class="social-items my-3">{% include '_includes/_partials/social' %}</div>
						{% endif %}
					</div>
				</nav>
			</div>
		</div>
	</div>
</div>
