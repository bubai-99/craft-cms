{% extends "_layouts/entry" %}
{% import "_helpers/images" as images %}
{% import '_includes/_partials/ctaButton' as buttons %}

{% set blockImages = entry.images.all() ?? [] %}
{% set featureItems = entry.featureItemTable ?? [] %}

{% set productButton = entry.button.all() %}

{% set product = craft.entries()
    .section('products')
    .slug(craft.app.request.segment(2))
    .one() %}
{% block content %}

	{% set containerWidth = 'container' %}
	{% set blockTypeUid = '' %}
	{% set blockCssClasses = '' %}

	{% if product %}
	{% set singlePageBlockStyle = entry.singlePageBlockStyle.one() %}
	
	{% if singlePageBlockStyle is defined and singlePageBlockStyle %}
	{% include "_includes/matrix-blocks/singlePageBlockStyle" with {
		singlePageBlockStyle: singlePageBlockStyle
	} %}
	{% endif %}
	{% set themeSwitche = singlePageBlockStyle.themeColor ?? null %}

		{% if product.featureImage|length %}
			<section class="jarallax" data-jarallax data-speed=".65">
				{% set image = product.featureImage.one() %}
				{% if image %}
					<div class="jarallax-img bg-position-center-y" style="background-image: url('{{ image.url }}');"></div>
				{% endif %}
				<div class="d-none d-xxl-block" style="height: 500px;"></div>
				<div class="d-none d-xl-block d-xxl-none" style="height: 450px;"></div>
				<div class="d-none d-lg-block d-xl-none" style="height: 430px;"></div>
				<div class="d-none d-md-block d-lg-none" style="height: 400px;"></div>
				<div class="d-md-none" style="height: 300px;"></div>
			</section>
		{% endif %}

		

		<div class="bg-color" data-bs-theme="{{ themeSwitche ? 'dark' : 'light' }}">
			{% include "_includes/_partials/breadcrumbs" %}
			<div class="overflow-hidden standard-txt">
				<div class="{{ singlePageBlockStyle ? singlePageBlockStyle.SingleMatrixContainerWidth.value : 'container' }}">
					<div class="row pb-sm-3 pb-md-5 pt-5">
						<div class="col-12">
							<h1 class="h1 d-md-none">{{ product.title }}</h1>
							<div class="d-flex d-md-none align-items-center pb-3 mb-3">
								{% if product.discountPrice|length %}
									<div class="h3 mb-0 me-3">{{ product.discountPrice }}</div>
								{% endif %}
								{% if product.price|length %}
									<del class="fs-5 fw-medium text-body-secondary me-3">{{ product.price }}</del>
								{% endif %}
								{% if product.tags|length %}
									<span class="badge bg-danger bg-opacity-10 text-danger d-md-none">
										{% set tags = product.tags.all() %}
										{% if tags %}
											{% for tag in tags %}
												{{ tag.title }}
											{% endfor %}
										{% endif %}
									</span>
								{% endif %}
							</div>
						</div>
						<div class="col-md-6 gallery mb-3 mb-md-0">
							<div class="position-relative">
								<div class="swiper mySwiper2" data-swiper-options='{
										"loop": true,
										"spaceBetween": 0,
										"navigation": {
											"nextEl": ".swiper-button-next",
											"prevEl": ".swiper-button-prev"
										},
										"thumbs": {
										"swiper": ".mySwiper"
										},
										"breakpoints": {
											"576": { "slidesPerView": 1 },
											"992": { "slidesPerView": 1 }
										}
									}'>
									<div class="swiper-wrapper">
										{% for image in blockImages %}
											{% if image %}
												<div class="swiper-slide">

													<a class="d-block gallery-item card-hover zoom-effect" href="{{ image.url }}">
														<div class="d-flex justify-content-center align-items-center position-absolute top-0 start-0 w-100 h-100 overflow-hidden z-2 opacity-0">
															<i class="ai-zoom-in fs-2 text-white position-relative z-2"></i>
															<div class="position-absolute top-0 start-0 w-100 h-100 bg-dark opacity-40"></div>
														</div>
														<div class="zoom-effect-wrapper">
															{{ images.singleImg(image, 800, {'ratio': 1}, 'flex-shrink-0 w-100 zoom-effect-img') }}
														</div>
													</a>

												</div>
											{% endif %}
										{% endfor %}
									</div>
									<div class="swiper-button-next text-primary"></div>
									<div class="swiper-button-prev text-primary"></div>
								</div>
								<div thumbsslider="" class="swiper mySwiper mt-3" data-swiper-options='{
										"loop": true,
										"spaceBetween": 20,
										"slidesPerView": 4,
										"freeMode": true,
										"watchSlidesProgress": true
									}'>
									<div class="swiper-wrapper">
										{% for image in blockImages %}
											{% if image %}
												<div class="swiper-slide">
													{{ images.singleImg(image, 300, {'ratio': 1}, 'w-100') }}
												</div>
											{% endif %}
										{% endfor %}
									</div>
								</div>
							</div>
						</div>
						<div class="col-md-6 col-xl-5 offset-xl-1">
							<div class="position-md-sticky top-0">
								<div class="py-3 py-lg-4 py-xl-5">
									{% if product.tags|length %}
										<div class="d-flex align-items-center pt-3 py-3">
											<span class="badge bg-danger bg-opacity-10 text-danger d-none d-md-inline-block me-4">
												{% set tags = product.tags.all() %}
												{% if tags %}
													{% for tag in tags %}
														{{ tag.title }}
													{% endfor %}
												{% endif %}
											</span>
										</div>
									{% endif %}

									<h1 class="d-none d-md-inline-block pb-1 mb-2">{{ product.title }}</h1>
									{% if product.productDiscription|length %}
										<div class="fs-sm mb-4">{{ product.productDiscription }}</div>
									{% endif %}

									{% if featureItems|length %}
									<ul class="list-unstyled mb-5">
										{% for item in featureItems %}
											{% if item %}
												<li class="mb-2">
													{{ item.item }}
													<span class="text-dark fw-semibold ms-2">{{ item.quantity }}</span>
												</li>
											{% endif %}
										{% endfor %}
									</ul>
									{% endif %}

									{% if product.productDiscount %}
										<div class="d-none d-md-flex align-items-center pb-3 mb-3">
											<div class="h3 mb-0 me-3">{{ product.discountPrice }}</div>
											<del class="fs-5 fw-medium text-body-secondary">{{ product.price }}</del>
										</div>
									{% else %}
										<div class="d-none d-md-flex align-items-center pb-3 mb-3">
											<div class="h3 mb-0 me-3 d-none">{{ product.discountPrice }}</div>
											<div class="h3 mb-0 me-3">{{ product.price }}</div>
										</div>
									{% endif %}

									{% if productButton|length %}
										<div class="d-sm-flex d-md-block d-lg-flex py-4 py-md-3">
											{{ buttons.renderButton(productButton) }}
										</div>
									{% endif %}
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>

			{% include "_includes/matrix-container" with {
				entry: product,
				cache_key: 'entry-' ~ product.id
				} 
			%}
			<div class="bg-color overflow-hidden standard-txt" data-bs-theme="{{ themeSwitche ? 'dark' : 'light' }}">
				<div class="{{ singlePageBlockStyle ? singlePageBlockStyle.SingleMatrixContainerWidth.value : 'container' }} pt-xl-2 pb-3 mb-md-2 mb-lg-4 mb-xl-5">
					{% if generalEntry.displayProductReview is defined and generalEntry.displayProductReview|length %}
					{% set activeUserReply = generalEntry.activeUserReplyProduct %}
						<div class="row mt-5">
							<div class="col-lg-12 col-xl-12 pb-5">
								{% include "_includes/_partials/comments.twig" with { commentHandler: 'productReview', activeUserReply: activeUserReply } %}
							</div>
						</div>
					{% endif  %}
					<div class="row justify-content-center">
						<div class="col-lg-12 col-xl-12">
							<div class="border-top border-bottom py-3 d-flex justify-content-end">
								<a href="/products" class="btn btn-sm fs-sm order-lg-3 d-flex d-sm-inline-flex btn-{{ singlePageBlockStyle ? singlePageBlockStyle.buttonColor.value : 'primary' }}">
									<i class="ai-chevron-left fs-xl me-2 ms-n1"></i>
									Back to list
								</a>
							</div>
						</div>
					</div>
				</div>
			</div>

			<div class="w-100 overflow-hidden pt-3" style="background-color: {{ generalEntry.productBackgroundColor.one().colorcode ?? '' }}">
				<div class="{{ generalEntry.ProductRelatedContainerWidth.value }}">
					<div class="row">
						<div class="col-12 pb-5">
							{% include "_includes/_partials/_products/relatedProductCarousel.twig" with { product: product } %}
						</div>
					</div>
				</div>
			</div>
		</div>


	{% endif %}
{% endblock %}
