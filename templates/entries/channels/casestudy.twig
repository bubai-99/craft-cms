{% extends "_layouts/entry" %}
{% set casestudy = craft.entries()
    .section('casestudies')
    .slug(craft.app.request.segment(2))
    .one() %}
{% block content %}

{% set containerWidth = 'container' %}
{% set blockTypeUid = '' %}
{% set blockCssClasses = '' %}

{% set singlePageBlockStyle = entry.singlePageBlockStyle.one() %}

	{% if casestudy %}

	{% if singlePageBlockStyle is defined and singlePageBlockStyle %}
    {% include "_includes/matrix-blocks/singlePageBlockStyle" with {
        singlePageBlockStyle: singlePageBlockStyle
    } %}
    {% endif %}
    {% set themeSwitche = singlePageBlockStyle.themeColor ?? null %}

	<div class="bg-color" data-bs-theme="{{ themeSwitche ? 'dark' : 'light' }}">
		<div class="py-3 py-lg-4 py-xl-5 standard-txt">
			<div class="{{ singlePageBlockStyle ? singlePageBlockStyle.SingleMatrixContainerWidth.value : 'container' }}">
				<h1 class="display-4 text-center mb-0">{{ casestudy.title }}</h1>
			</div>
		</div>

		{% if casestudy.featureImage|length %}
			<section class="jarallax" data-jarallax data-speed=".65">
				{% set image = casestudy.featureImage.one() %}
				{% if image %}
					<div class="jarallax-img bg-position-center-y" style="background-image: url('{{ image.url }}');"></div>
				{% endif %}
				<div class="d-none d-xxl-block" style="height: 500px;"></div>
				<div class="d-none d-xl-block d-xxl-none" style="height: 450px;"></div>
				<div class="d-none d-lg-block d-xl-none" style="height: 430px;"></div>
				<div class="d-none d-md-block d-lg-none" style="height: 400px;"></div>
				<div class="d-md-none" style="height: 300px;"></div>
			</section>
		{% endif %}

		{% include "_includes/_partials/breadcrumbs" %}

		<div class="py-3 pt-lg-4 pt-xl-5 pb-lg-1 pb-xl-2 standard-txt">
			<div class="{{ singlePageBlockStyle ? singlePageBlockStyle.SingleMatrixContainerWidth.value : 'container' }}">
				<div class="d-flex align-items-center text-decoration-none pb-3">
					<h6 class="mb-0 text-body-secondary">
						<span class="text-dark text-uppercase">Industry:</span>
						{{ casestudy.industry }}
					</h6>
				</div>
				<div class="d-flex flex-wrap align-items-center justify-content-start mt-n2">
					{% if casestudy.tags|length %}
						<span class="fs-md text-dark me-2 fw-bold">Skills:</span>
						{% set tags = casestudy.tags.all() %}
						{% if tags %}
							{% for tag in tags %}
								<a class="badge text-nav fs-xs border me-2 my-1">{{ tag.title }}</a>
							{% endfor %}
						{% endif %}
					{% endif %}
				</div>
			</div>
		</div>

		{% include "_includes/matrix-container" with {
            entry: casestudy,
            cache_key: 'entry-' ~ casestudy.id
            } 
        %}

		<div class="pt-xl-2 pb-5 mb-md-2 mb-lg-4 mb-xl-5">
			<div class="{{ singlePageBlockStyle ? singlePageBlockStyle.SingleMatrixContainerWidth.value : 'container' }}">
				<div class="row justify-content-center">
					<div class="col-lg-12 col-xl-12">
						<div class="border-top border-bottom py-3 d-flex justify-content-end">
							<a href="/casestudy" class="btn btn-sm fs-sm order-lg-3 d-flex d-sm-inline-flex btn-{{ singlePageBlockStyle ? singlePageBlockStyle.buttonColor.value : 'primary' }}">
								<i class="ai-chevron-left fs-xl me-2 ms-n1"></i>
								Back to list
							</a>
						</div>
					</div>
				</div>
			</div>
		</div>

		<div class="w-100 overflow-hidden pt-3" style="background-color: {{ generalEntry.caseStudyBackgroundColor.one().colorcode ?? '' }}">
			<div class="{{ generalEntry.caseRelatedContainerWidth.value }}">
				<div class="row">
					<div class="col-12 pb-5">
						{% include "_includes/_partials/_casestudies/relatedCaseStudyCarousel.twig" with { casestudy: casestudy } %}
					</div>
				</div>
			</div>
		</div>
	</div>

	{% endif %}
{% endblock %}
