<!DOCTYPE html>
<html lang="{{ craft.app.language }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    
    <title>{% block title %}{{ siteName }}{% endblock %}</title>
    
    {% block meta %}
        <meta name="description" content="{% block description %}{{ siteDescription ?? '' }}{% endblock %}">
    {% endblock %}
    
    {% block css %}
        {# Critical inline styles to prevent FOUC #}
        <style>
            /* Prevent flash of unstyled content */
            html { 
                background-color: #f9fafb; 
                color: #111827;
            }
            body { 
                visibility: hidden;
                opacity: 0;
                transition: opacity 0.15s ease-in;
                font-family: system-ui, -apple-system, sans-serif;
                line-height: 1.5;
                margin: 0;
            }
            body.loaded { 
                visibility: visible; 
                opacity: 1; 
            }
            /* Critical layout styles */
            * { 
                box-sizing: border-box; 
                margin: 0; 
                padding: 0;
            }
        </style>
        
        {# Load all assets together for better performance #}
        {{ craft.vite.script('src/main.js') }}
        {{ craft.vite.script('src/scripts/pages/home.js') }}

    {% endblock %}
    
    {% block extraHead %}{% endblock %}
</head>
<body{% block bodyAttributes %}{% endblock %}>
    {% block header %}
        {% include '_partials/navigation.twig' %}
    {% endblock %}
    
    <main class="site-main" role="main">
        {% block content %}{% endblock %}
    </main>
    
    {% block footer %}
        {% include '_partials/footer.twig' %}
    {% endblock %}
    
    {% block js %}
        {# JavaScript already loaded in head with CSS #}
    {% endblock %}
    
    {% block extraFooter %}{% endblock %}
</body>
</html>