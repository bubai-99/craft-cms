{% extends "_layouts/entry" %}

{% block header_banner %}
    {% cache %}
    {% if entry.standardBannerSlider is defined and entry.standardBannerSlider %}
        {% set standardBannerSliders = entry.standardBannerSlider.all() %}
        {% if standardBannerSliders | length  > 0 %}
            <div class="header-banner">
                {% include "_includes/hero-banner/standardSliderLayout"%}
            </div>
        {% endif %}
    {% endif %}
	{% endcache %}

{% endblock %}

{% block before_content %}
	{% if entry.section.handle not in ['contact'] %}
		{% include "_includes/_partials/breadcrumbs" %}
	{% endif %}
{% endblock %}

{% block content %}

    {% if entry.hideTitleHere and entry.h1Title|length %}
        <div class="{{ entry.titleContainerWidth.value }} py-2 py-lg-3">
            <div class="row">
                <div class="col-12">
                    <h1 class="block-heading-title mb-0 text-{{ entry.titleAlign.value }}">{{ entry.h1Title}}</h1>
                </div>
            </div>
        </div>
    {% endif %}

	{% block before_content_matrix %}{% endblock %}
	{% block content_matrix %}
		{% set content = entry.matrixContent %}
		{% include "_includes/matrix-container" with {
            cache_key: 'entry-' ~ entry.id
        } %}
	{% endblock %}
	{% block after_content_matrix %}{% endblock %}
{% endblock %}
