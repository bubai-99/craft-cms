{% extends "_layouts/cp" %}

{% set title = "Menus"|t('menu-manager') %}

{% block content %}
    <div id="menus-index" class="tableview">
        <div class="toolbar">
            <div class="flex">
                <h1>{{ title }}</h1>
            </div>
            <div class="flex-grow"></div>
            <div class="buttons">
                <a href="{{ url('menu-manager/menus/new') }}" class="btn submit add">{{ "New Menu"|t('menu-manager') }}</a>
            </div>
        </div>

        {% if menus|length %}
            <table class="data fullwidth">
                <thead>
                    <tr>
                        <th scope="col">{{ "Name"|t('menu-manager') }}</th>
                        <th scope="col">{{ "Handle"|t('menu-manager') }}</th>
                        <th scope="col">{{ "Items"|t('menu-manager') }}</th>
                        <th scope="col">{{ "Actions"|t('menu-manager') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for menu in menus %}
                        <tr>
                            <td>
                                <a href="{{ url('menu-manager/menus/' ~ menu.id) }}">
                                    <strong>{{ menu.name }}</strong>
                                </a>
                            </td>
                            <td>
                                <code>{{ menu.handle }}</code>
                            </td>
                            <td>
                                {{ menu.structure|length }}
                            </td>
                            <td>
                                <a href="{{ url('menu-manager/menus/' ~ menu.id) }}" class="btn small">{{ "Edit"|t('menu-manager') }}</a>
                                <form method="post" class="inline">
                                    {{ csrfInput() }}
                                    {{ hiddenInput('action', 'menu-manager/menus/delete') }}
                                    {{ hiddenInput('id', menu.id) }}
                                    {{ redirectInput('menu-manager') }}
                                    <button type="submit" class="btn small" 
                                            onclick="return confirm('{{ 'Are you sure you want to delete this menu?'|t('menu-manager') }}');">
                                        {{ "Delete"|t('menu-manager') }}
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <div class="zilch">
                <p>{{ "No menus exist yet."|t('menu-manager') }}</p>
                <p><a href="{{ url('menu-manager/menus/new') }}" class="btn submit add">{{ "Create your first menu"|t('menu-manager') }}</a></p>
            </div>
        {% endif %}
    </div>
{% endblock %}