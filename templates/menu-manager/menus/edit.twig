{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}

{% set title = isNew ? "Create a new menu"|t('menu-manager') : menu.name %}

{% block content %}
    <form method="post" accept-charset="UTF-8">
        {{ csrfInput() }}
        {{ hiddenInput('action', 'menu-manager/menus/save') }}
        {% if not isNew %}{{ hiddenInput('id', menu.id) }}{% endif %}
        {{ redirectInput('menu-manager') }}

        <div class="grid first">
            <div class="item" data-position="left" data-min-colspan="2" data-max-colspan="3">
                <div id="fields" class="pane">
                    {{ forms.textField({
                        label: "Name"|t('menu-manager'),
                        instructions: "What this menu will be called in the CP."|t('menu-manager'),
                        id: 'name',
                        name: 'name',
                        value: menu.name,
                        errors: menu.getErrors('name'),
                        autofocus: true,
                        required: true
                    }) }}

                    {{ forms.textField({
                        label: "Handle"|t('menu-manager'),
                        instructions: "How you'll refer to this menu in the templates."|t('menu-manager'),
                        id: 'handle',
                        name: 'handle',
                        class: 'code',
                        autocorrect: false,
                        autocapitalize: false,
                        value: menu.handle,
                        errors: menu.getErrors('handle'),
                        required: true
                    }) }}

                    {{ forms.textField({
                        label: "Max Levels"|t('menu-manager'),
                        instructions: "The maximum number of levels this menu can have. Leave blank for no limit."|t('menu-manager'),
                        id: 'maxLevels',
                        name: 'maxLevels',
                        type: 'number',
                        min: 1,
                        value: menu.maxLevels
                    }) }}
                </div>
            </div>

            <div class="item" data-position="right" data-colspan="1">
                <div id="settings" class="pane meta">
                    <div class="field">
                        <div class="heading">
                            <label>{{ "Menu Structure"|t('menu-manager') }}</label>
                            <div class="instructions"><p>{{ "Build your menu structure here."|t('menu-manager') }}</p></div>
                        </div>
                        <div class="input">
                            <div id="menu-builder">
                                <p>{{ "Menu builder will be available after saving the menu."|t('menu-manager') }}</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="buttons">
            <button type="submit" class="btn submit">{{ "Save"|t('menu-manager') }}</button>
        </div>
    </form>

    <script>
        new Craft.HandleGenerator('#name', '#handle');
    </script>
{% endblock %}