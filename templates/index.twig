{% extends "_layouts/base.twig" %}

{% block title %}Welcome to Craft CMS with Vite{% endblock %}

{% block content %}
    {# Hero Section #}
    <div class="hero-section">
        <div class="container">
            <h1>Welcome to Craft CMS 5</h1>
            <p class="lead">A powerful, flexible content management system with modern Vite integration and Matrix block architecture.</p>
        </div>
    </div>

    <div class="container">
        <div id="app">
            {# Features Section #}
            <div class="content-section">
                <div class="row">
                    <div class="col-md-8">
                        <h2>What's Included</h2>
                        <div class="features">
                            <ul>
                                <li>✅ <strong>Craft CMS 5</strong> - Latest version with Matrix blocks as entries</li>
                                <li>✅ <strong>Vite Integration</strong> - Modern frontend build tool with HMR</li>
                                <li>✅ <strong>Matrix Blocks</strong> - Text, Heading, Image, Quote, Gallery blocks</li>
                                <li>✅ <strong>Template Structure</strong> - Professional, modular template architecture</li>
                                <li>✅ <strong>Navigation System</strong> - Menu Manager plugin integration</li>
                                <li>✅ <strong>Responsive Design</strong> - Mobile-first CSS framework</li>
                                <li>✅ <strong>CKEditor</strong> - Rich text editing capabilities</li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="contact-info">
                            <h3>Getting Started</h3>
                            <p><strong>Control Panel:</strong><br>
                            <a href="{{ cpUrl('') }}">{{ cpUrl('') }}</a></p>
                            
                            <p><strong>Sample Pages:</strong><br>
                            <a href="/about">About Us</a><br>
                            <a href="/contact">Contact</a><br>
                            <a href="/blog">Blog</a></p>
                            
                            <p><strong>Admin Tasks:</strong><br>
                            • Create Matrix fields<br>
                            • Add content blocks<br>
                            • Upload images<br>
                            • Customize navigation</p>
                        </div>
                    </div>
                </div>
            </div>

            {# Latest Entries Section #}
            {% set latestEntries = craft.entries.section('pages').limit(3).all() %}
            {% if latestEntries|length %}
                <div class="content-section">
                    <h2>Latest Pages</h2>
                    <div class="blog-grid">
                        {% for entry in latestEntries %}
                            {% include '_components/card.twig' with {
                                title: entry.title,
                                excerpt: entry.content ? (entry.content|striptags|slice(0, 120) ~ '...') : 'Click to view this page and add some content!',
                                url: entry.url,
                                date: entry.dateCreated,
                                showReadMore: true
                            } %}
                        {% endfor %}
                    </div>
                </div>
            {% else %}
                {# Demo Content when no entries exist #}
                <div class="content-section">
                    <h2>Sample Content Structure</h2>
                    <p>Here's how your content will look once you create pages:</p>
                    <div class="blog-grid">
                        {% for i in 1..3 %}
                            {% include '_components/card.twig' with {
                                title: 'Sample Page ' ~ i,
                                excerpt: 'This is how your pages will appear once you create them in the control panel. You can add Matrix blocks, rich content, and images.',
                                url: '#',
                                date: now,
                                showReadMore: true,
                                variant: 'demo'
                            } %}
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            {# Matrix Blocks Demo #}
            <div class="content-section">
                <h2>Matrix Block Examples</h2>
                <p>Here are examples of the Matrix blocks you can use:</p>
                
                {# Demo Text Block #}
                <div class="block block--text">
                    <h3 class="block__heading">Text Block Example</h3>
                    <div class="block__content">
                        <p>This is an example of a <strong>Text Block</strong>. You can add rich formatted content including <em>italic text</em>, <strong>bold text</strong>, links, lists, and more using the CKEditor interface.</p>
                        <p>Matrix blocks are the building blocks of your content, allowing you to create flexible, structured pages.</p>
                    </div>
                </div>

                {# Demo Heading Block #}
                <div class="block block--heading">
                    <h2 class="block__heading">Heading Block Example</h2>
                    <p class="block__subheading">With optional subheading text for additional context</p>
                </div>

                {# Demo Quote Block #}
                <div class="block block--quote">
                    <blockquote class="block__quote">
                        <p class="block__quote-text">Matrix blocks in Craft CMS 5 are now entries, providing unprecedented flexibility for content modeling and template organization.</p>
                        <footer class="block__quote-footer">
                            <cite class="block__quote-author">Craft CMS Documentation</cite>
                        </footer>
                    </blockquote>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
